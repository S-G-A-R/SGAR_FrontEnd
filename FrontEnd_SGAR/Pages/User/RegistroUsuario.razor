            var data = new
            {
                id = 0,
                nombre,
                apellido,
                telefono,
                email,
                dui,
                foto = fotoBase64 ?? "", // cadena vacía si no se sube imagen
                password,
                idRol = 1 // Ciudadano automático
            };

            var response = await Http.PostAsJsonAsync("api/user", data);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResponseMessage>();
                await JS.InvokeVoidAsync("alert", $"✅ Usuario creado: {result?.Message ?? "Éxito"}");
                Cancelar();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
