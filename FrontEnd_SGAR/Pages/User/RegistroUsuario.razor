@page "/registro-usuario"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<link href="css/registro-organizacion.css" rel="stylesheet" />

<!-- ✅ Notificación tipo campana -->
<div id="successAlert" class="success-alert hidden">
    <div class="alert-box">
        <div class="alert-icon">🔔</div>
        <div class="alert-text" id="alertMessage">Usuario registrado con éxito</div>
    </div>
</div>

<div class="registro-container">
    <div class="registro-card">
        <h3><i class="bi bi-person-plus me-2"></i>Registrar Usuario</h3>
        <hr />

        <!-- Nombre -->
        <div class="form-group">
            <label class="required">Nombre</label>
            <input value="@nombre" @oninput="ValidarNombre" class="form-control" placeholder="Ingresa tu nombre" />
            <div class="error-message">@errorNombre</div>
        </div>

        <!-- Apellido -->
        <div class="form-group">
            <label class="required">Apellido</label>
            <input value="@apellido" @oninput="ValidarApellido" class="form-control" placeholder="Ingresa tu apellido" />
            <div class="error-message">@errorApellido</div>
        </div>

        <!-- Teléfono -->
        <div class="form-group">
            <label>Teléfono</label>
            <input id="telefonoInput" value="@telefono" @oninput="ValidarTelefono" class="form-control" placeholder="0000 0000" maxlength="9" />
            <div class="error-message">@errorTelefono</div>
        </div>

        <!-- Email -->
        <div class="form-group">
            <label class="required">Correo electrónico</label>
            <input value="@email" @oninput="ValidarEmail" class="form-control" placeholder="ejemplo@correo.com" />
            <div class="error-message">@errorEmail</div>
        </div>

        <!-- DUI -->
        <div class="form-group">
            <label class="required">DUI</label>
            <input value="@dui" @oninput="FormatearDui" maxlength="10" class="form-control" placeholder="00000000-0" />
            <div class="error-message">@errorDui</div>
        </div>

        <!-- Foto -->
        <div class="form-group">
            <label>Foto (opcional)</label>
            <InputFile OnChange="OnFileChange" class="form-control" />
        </div>

        <!-- Contraseña -->
        <div class="form-group">
            <label class="required">Contraseña</label>
            <input type="password" value="@password" @oninput="ValidarPassword" class="form-control" placeholder="Crea una contraseña" />
            <div class="error-message">@errorPassword</div>
        </div>

        <!-- Botones -->
        <div class="botones mt-4">
            <div class="contenedor-boton">
                <button class="boton-mapacheAceptar" @onclick="Registrar">Registrar</button>
                <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                <img src="css/orejaIz.png" class="oreja oreja-derecha" />
            </div>
            <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
        </div>
    </div>
</div>

<!-- ✅ JS -->
<script>
    function showSuccessAlert() {
        const alert = document.getElementById("successAlert");
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const telInput = document.getElementById("telefonoInput");

        // ✅ Solo permite números y espacio (sin letras ni símbolos)
        telInput.addEventListener("input", function (e) {
            let val = e.target.value.replace(/[^0-9 ]/g, ""); // elimina letras y símbolos

            // Elimina espacios extras y mantiene formato 0000 0000
            val = val.replace(/\s+/g, "");
            if (val.length > 8) val = val.substring(0, 8);
            if (val.length > 4)
                val = val.substring(0, 4) + " " + val.substring(4);
            e.target.value = val.trim();

            // Actualizar bind de Blazor
            const inputEvent = new Event('input', { bubbles: true });
            e.target.dispatchEvent(inputEvent);
        });
    });
</script>

<!-- ✅ CSS -->
<style>
    .error-message {
        color: #d9534f;
        font-size: 0.85rem;
        margin-top: 4px;
        min-height: 18px;
    }

    .success-alert {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 0;
    }

        .success-alert.show {
            opacity: 1;
            transform: translateX(-50%) translateY(10px);
        }

        .success-alert.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .alert-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        color: #ffcc00;
        animation: ring 0.6s ease-in-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }

    @@keyframes ring {
        0% {
            transform: rotate(0);
        }

        25% {
            transform: rotate(10deg);
        }

        50% {
            transform: rotate(-10deg);
        }

        75% {
            transform: rotate(10deg);
        }

        100% {
            transform: rotate(0);
        }
    }
</style>

@code {
    private string nombre = "";
    private string apellido = "";
    private string telefono = "";
    private string email = "";
    private string dui = "";
    private string password = "";
    private byte[]? foto;

    private string errorNombre = "";
    private string errorApellido = "";
    private string errorTelefono = "";
    private string errorEmail = "";
    private string errorDui = "";
    private string errorPassword = "";

    private void ValidarNombre(ChangeEventArgs e)
    {
        nombre = e.Value?.ToString() ?? "";
        errorNombre = string.IsNullOrEmpty(nombre) || System.Text.RegularExpressions.Regex.IsMatch(nombre, @"^[a-zA-Z\s]+$")
            ? ""
            : "Solo se permiten letras.";
    }

    private void ValidarApellido(ChangeEventArgs e)
    {
        apellido = e.Value?.ToString() ?? "";
        errorApellido = string.IsNullOrEmpty(apellido) || System.Text.RegularExpressions.Regex.IsMatch(apellido, @"^[a-zA-Z\s]+$")
            ? ""
            : "Solo se permiten letras.";
    }

    private void ValidarEmail(ChangeEventArgs e)
    {
        email = e.Value?.ToString() ?? "";
        errorEmail = string.IsNullOrEmpty(email) || System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$")
            ? ""
            : "Correo inválido.";
    }

    public void FormatearDui(ChangeEventArgs e)
    {
        dui = e.Value?.ToString() ?? "";
        dui = new string(dui.Where(char.IsDigit).ToArray());

        if (dui.Length > 8)
            dui = dui.Insert(8, "-");

        if (dui.Length > 10)
            dui = dui.Substring(0, 10);

        if (!System.Text.RegularExpressions.Regex.IsMatch(dui.Replace("-", ""), @"^\d+$"))
            errorDui = "Solo se permiten números.";
        else
            errorDui = dui.Length == 10 ? "" : "Debe contener 9 dígitos.";
    }

    // ✅ NUEVA validación de teléfono: solo números, formato 0000 0000
    private void ValidarTelefono(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        string soloNumeros = new string(input.Where(char.IsDigit).ToArray());

        if (soloNumeros.Length > 8)
            soloNumeros = soloNumeros.Substring(0, 8);

        if (soloNumeros.Length > 4)
            telefono = $"{soloNumeros.Substring(0, 4)} {soloNumeros.Substring(4)}";
        else
            telefono = soloNumeros;

        if (input.Any(c => !char.IsDigit(c) && c != ' '))
            errorTelefono = "Solo se permiten números.";
        else if (soloNumeros.Length < 8)
            errorTelefono = "Número de teléfono incompleto.";
        else
            errorTelefono = "";
    }

    private void ValidarPassword(ChangeEventArgs e)
    {
        password = e.Value?.ToString() ?? "";
        errorPassword = password.Length < 6 ? "Debe tener al menos 6 caracteres." : "";
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                errorPassword = "⚠️ La imagen no puede superar los 5MB.";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            foto = ms.ToArray();
        }
    }

    private async Task Registrar()
    {
        errorNombre = errorApellido = errorEmail = errorDui = errorPassword = "";

        bool camposVacios =
            string.IsNullOrWhiteSpace(nombre) ||
            string.IsNullOrWhiteSpace(apellido) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(dui) ||
            string.IsNullOrWhiteSpace(password);

        if (!string.IsNullOrEmpty(dui) && !System.Text.RegularExpressions.Regex.IsMatch(dui.Replace("-", ""), @"^\d+$"))
        {
            errorDui = "Solo se permiten números.";
            camposVacios = true;
        }

        if (camposVacios)
        {
            if (string.IsNullOrWhiteSpace(nombre)) errorNombre = "Este campo es obligatorio.";
            if (string.IsNullOrWhiteSpace(apellido)) errorApellido = "Este campo es obligatorio.";
            if (string.IsNullOrWhiteSpace(email)) errorEmail = "Este campo es obligatorio.";
            if (string.IsNullOrWhiteSpace(dui)) errorDui = "Este campo es obligatorio.";
            if (string.IsNullOrWhiteSpace(password)) errorPassword = "Este campo es obligatorio.";
            errorPassword = "⚠️ Por favor completa todos los campos requeridos.";
            return;
        }

        // ✅ Ahora también valida teléfono antes de registrar
        if (!string.IsNullOrEmpty(errorNombre) ||
            !string.IsNullOrEmpty(errorApellido) ||
            !string.IsNullOrEmpty(errorEmail) ||
            !string.IsNullOrEmpty(errorDui) ||
            !string.IsNullOrEmpty(errorTelefono) ||   // <--- agregado
            !string.IsNullOrEmpty(errorPassword))
        {
            errorPassword = "⚠️ Corrige los campos antes de continuar.";
            return;
        }

        // Además, evita enviar si el teléfono tiene letras o es incompleto
        if (string.IsNullOrWhiteSpace(telefono) ||
            telefono.Replace(" ", "").Length < 8 ||
            !System.Text.RegularExpressions.Regex.IsMatch(telefono.Replace(" ", ""), @"^\d+$"))
        {
            errorTelefono = "Número de teléfono inválido.";
            errorPassword = "⚠️ Corrige los campos antes de continuar.";
            return;
        }

        try
        {
            string? fotoBase64 = foto != null && foto.Length > 0 ? Convert.ToBase64String(foto) : null;

            var data = new
            {
                id = 0,
                nombre,
                apellido,
                telefono,
                email,
                dui,
                fotoBase64 = fotoBase64 ?? "",
                // foto = fotoBase64 ?? "",
                password,
                idRol = 1
            };

            var response = await Http.PostAsJsonAsync("api/user", data);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("showSuccessAlert");
                await Task.Delay(3000);
                Nav.NavigateTo("/login-ciudadano");
            }
            else
            {
                errorPassword = "❌ Error al registrar usuario.";
            }
        }
        catch (Exception ex)
        {
            errorPassword = $"⚠️ Error de conexión: {ex.Message}";
        }
    }

    private void Cancelar()
    {
        nombre = apellido = telefono = email = dui = password = "";
        foto = null;
        Nav.NavigateTo("/login-ciudadano");
    }
}




