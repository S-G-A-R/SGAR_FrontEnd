@page "/login-ciudadano"
@using FrontEnd_SGAR.Models
@using FrontEnd_SGAR.Services
@inject AuthSeguridadService AuthSeguridadService
@inject NavigationManager Navigation
@inject IJSRuntime JS


<style>
    .form-control {
        border: 2px solid #ccc !important;
        border-radius: 10px !important;
        padding-left: 40px;
    }

        .form-control:focus {
            border-color: #6c757d !important;
            box-shadow: 0 0 8px rgba(108, 117, 125, 0.5) !important;
        }

    .card {
        border: 2px solid #ccc !important;
        box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.1) !important;
        border-radius: 20px !important;
    }

    .input-group {
        position: relative;
        width: 100%;
    }

        .input-group .input-group-text {
            position: absolute;
            top: 50%;
            left: 10px;
            transform: translateY(-50%);
            background: none !important;
            border: none !important;
            z-index: 10;
        }

    .input-group-text i {
        font-size: 18px;
        color: #6c757d;
    }

    .input-label {
        position: absolute;
        top: -10px;
        left: 10px;
        font-size: 14px;
        color: #6c757d;
        background-color: white;
        padding: 0 5px;
        z-index: 5;
    }

    .contenedor-boton {
        position: relative;
        display: inline-block;
        margin: 15px;
    }

    .boton-mapacheAceptar {
        min-width: 115px;
        padding: 10px 20px;
        font-size: 16px;
        cursor: pointer;
        border-radius: 10px;
        height: 50px;
        width: 115px;
        background-color: #b0abab; /* gris suave */
        color: #fff;
        font-weight: bold;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        /* Hover: borde negro, fondo más oscuro, texto más fuerte */
        .boton-mapacheAceptar:hover {
            border: 3px solid black;
            background-color: #9a9494; /* un gris más oscuro, no negro */
            color: black; /* texto negro al pasar el mouse */
            font-weight: bold;
        }

    .oreja {
        position: absolute;
        width: 27px; /* un poco más pequeñas para pegarse */
        height: 27px;
        display: none;
        transition: transform 0.3s ease;
    }

    /* Ajuste para que se vean más juntas al botón */
    .oreja-izquierda {
        top: -22px; /* más cerca */
        left: 8px;
    }

    .oreja-derecha {
        top: -22px;
        right: 8px;
    }

    /* Mostrar orejas al pasar el mouse */
    .contenedor-boton:hover .oreja {
        display: block;
        transform: translateY(-5px);
    }


</style>

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <div class="card p-3 rounded-4">
            <div class="card-body">
                <!-- Logo -->
                <div class="d-flex justify-content-center mb-3">
                    <img src="css/sgarlogo.jpeg" width="200" height="200" />
                </div>

                <EditForm Model="@credenciales" OnValidSubmit="@IniciarSesion">
                    <DataAnnotationsValidator />
@*                     <ValidationSummary />
 *@
                    <!-- Campo Email -->
                    <div class="form-group mb-3 position-relative">
                        <div class="input-group">
                            <InputText @bind-Value="credenciales.Email"
                                       class="form-control border-start-0 rounded-3 ps-6 pe-4"
                                       placeholder="mail@example.com"
                                       autocomplete="email" />
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                        </div>
                        <label class="input-label required">Correo</label>
                        <ValidationMessage For="@(() => credenciales.Email)" />
                        </div>

                    <!-- Campo Password -->
                    <div class="form-group mb-4 position-relative">
                        <div class="input-group">
                            <InputText @bind-Value="credenciales.Password"
                                       type="password"
                                       id="password"
                                       class="form-control border-start-0 rounded-3 ps-6 pe-4"
                                       placeholder="*****"
                                       autocomplete="current-password" />
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                        </div>
                        <label class="input-label required">Contraseña</label>
                     <ValidationMessage For="@(() => credenciales.Password)" />
                   </div>

                    <!-- Botón Login -->
                    <div class="d-flex justify-content-center">
                        <div class="contenedor-boton">
                            <button type="submit" class="boton-mapacheAceptar text-center">Aceptar</button>
                            <img src="/css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                            <img src="/css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
                        </div>
                    </div>
                </EditForm>

                @if (!string.IsNullOrEmpty(errorMensaje))
                {
                    <div class="alert alert-danger text-center mt-3">@errorMensaje</div>
                }

                <div class="d-flex justify-content-center mt-3">
                    <p>
                        ¿No tienes cuenta?
                        <NavLink href="/registro-usuario" class="text-decoration-none fw-bold" style="color:#000;">
                            Regístrate
                        </NavLink>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CredencialesRequest credenciales = new();
    private string? errorMensaje;

    private async Task IniciarSesion()
    {
        errorMensaje = null;

        // Llamamos al servicio de autenticación
        var token = await AuthSeguridadService.LoginAsync(credenciales);

        if (string.IsNullOrEmpty(token))
        {
            errorMensaje = "Credenciales inválidas. Verifica tu correo y contraseña.";
            return;
        }

        //Decodificar token (según claims del backend)
        var jwt = await AuthSeguridadService.ObtenerTokenDecodificado();

        var email = jwt?.Claims.FirstOrDefault(c => c.Type == "email")?.Value;
        var rol = jwt?.Claims.FirstOrDefault(c => c.Type == "role")?.Value;
        var userId = jwt?.Claims.FirstOrDefault(c => c.Type == "nameid")?.Value;

        Console.WriteLine($"Usuario logueado: {email} - Rol: {rol} - Id: {userId}");

        // Guardar info útil en localStorage
        await JS.InvokeVoidAsync("localStorage.setItem", "userEmail", email ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "userRole", rol ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "userId", userId ?? "");

        //alerta personalizada 
        await JS.InvokeVoidAsync("MostrarAlerta", new
        {
            title = "¡Ingreso Exitoso! ✅",
            html = $"<p>Bienvenido/a<br><strong>{email}</strong></p>",
            imageUrl = "/css/Iniciomapachito.png", 
            showConfirmButton = false,
            timer = 3000,
            timerProgressBar = true
        });

        await Task.Delay(3000);

        // Redirigir a página principal
        Navigation.NavigateTo("/MenuCiudadano", true);
    }
}
