@page "/administrador/categorias/detalles/{id:int}"
@using SgarApiVenta.Client.Models
@* @inject CategoriaProductoService CategoriaProductoService *@
@inject NavigationManager NavManager

<h3 class="mb-3 text-secondary">Detalles de la Categoría</h3>

@if (categoria == null)
{
    <div class="alert alert-warning shadow-sm">Cargando información...</div>
}
else
{
    <div class="card shadow-sm border-0" style="background-color:#f7f7f7;">
        <div class="card-body">

            <div class="mb-3">
                <label class="fw-semibold text-secondary">ID:</label>
                <p class="mb-1">@categoria.Id</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold text-secondary">Nombre:</label>
                <p class="mb-1">@categoria.NombreCat</p>
            </div>

            <hr />

            <div class="d-flex justify-content-end">
                <button class="btn btn-outline-secondary" @onclick="Volver">
                    Volver
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int id { get; set; }
    private CategoriaProducto? categoria;

    @* protected override async Task OnInitializedAsync()
    {
        categoria = await CategoriaProductoService.GetCategoriaByIdAsync(id);
    } *@

    private void Volver()
    {
        NavManager.NavigateTo("/administrador/categorias/indexcategorias");
    }
}
