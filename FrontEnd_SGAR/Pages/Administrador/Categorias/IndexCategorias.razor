    {
        if (categorias?.TienePaginaSiguiente == true)
        {
            paginaActual++;
            await CargarCategorias();
        }
    }

    private async Task Anterior()
    {
        if (categorias?.TienePaginaAnterior == true)
        {
            paginaActual--;
            await CargarCategorias();
        }
    }
