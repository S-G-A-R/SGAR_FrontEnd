@page "/tipoSuscripcion-crear"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.TipoSuscripcionDTO
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject TipoSuscripcionService TipoSuscripcionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="card shadow-lg p-4 custom-form-card">

        <h3 class="text-center mb-4 fw-bold text-dark">
            <i class="bi bi-tag-fill me-2"></i> Crear Nuevo Plan
        </h3>
        <hr />

        <EditForm Model="modelo" OnValidSubmit="Registrar">
            <DataAnnotationsValidator />

            <div class="row g-3">

                <div class="col-12">
                    <div class="form-group">
                        <label class="required fw-semibold">Nombre del Plan</label>
                        <InputText @bind-Value="modelo.SuscripcionNombre" class="form-control"
                            placeholder="Ej: Plan Básico / Plan Premium" />
                        <ValidationMessage For="@(() => modelo.SuscripcionNombre)" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="required fw-semibold">Precio ($)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <InputNumber @bind-Value="modelo.Precio" class="form-control" placeholder="0.00" />
                        </div>
                        <ValidationMessage For="@(() => modelo.Precio)" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="required fw-semibold">Límite de Productos/Entidades</label>
                        <InputNumber @bind-Value="modelo.Limite" class="form-control"
                            placeholder="Máximo de productos a registrar" />
                        <ValidationMessage For="@(() => modelo.Limite)" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-semibold text-secondary">Fecha de Inicio</label>
                        <div class="form-control-plaintext text-muted">(Funcionalidad Pendiente)</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-semibold text-secondary">Fecha Fin</label>
                        <div class="form-control-plaintext text-muted">(Funcionalidad Pendiente)</div>
                    </div>
                </div>
            </div>

            <hr class="mt-4 mb-3" />

            <div class="d-flex gap-3 justify-content-center mt-4">

                <button type="submit" class="btn btn-success px-4 py-2 custom-btn-size">
                    <i class="bi bi-check-circle me-1"></i> Crear Plan
                </button>

                <button type="button" class="btn btn-secondary px-4 py-2 custom-btn-size" @onclick="Cancelar">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
            </div>

        </EditForm>

        <div id="successAlert" class="success-alert hidden">
            <div class="alert-box">
                <div class="alert-icon">🔔</div>
                <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
            </div>
        </div>

    </div>
</div>

<style>
    .custom-form-card {
        max-width: 600px;
        margin: 40px auto;
        border-radius: 12px;
    }

    /* Estilo para labels requeridos */
    label.required::after {
        content: " *";
        color: red;
        font-weight: bold;
    }

    /* Tamaño consistente para los botones de acción */
    .custom-btn-size {
        min-width: 150px;
        font-weight: 600;
        border-radius: 8px;
        transition: transform 0.1s;
    }

    .custom-btn-size:hover {
        transform: translateY(-2px);
    }

    /* Nota: Se eliminaron los estilos .btn-buscar y .btn-limpiar 
       porque ahora usamos clases estándar de Bootstrap (btn-success, btn-secondary).
       Si quieres mantener tus estilos personalizados, renombra y ajusta: */

    /* Ejemplo de como se verían tus estilos personalizados reescritos a clases de Boostrap si los necesitas: */
    /* .btn-success { background-color: #4CAF50; border-color: #4CAF50; } */
    /* .btn-secondary { background-color: #6c757d; border-color: #6c757d; } */

    /* Estilos del JavaScript de alerta (Se mantiene) */
    .success-alert {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        transition: all 0.4s ease;
        opacity: 0;
        transform: translateY(-20px);
    }

    .success-alert.show {
        opacity: 1;
        transform: translateY(0);
    }

    .success-alert.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .alert-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        color: #ffcc00;
        animation: ring 0.6s ease-in-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
</style>


<script>
    // ... (El código JavaScript para showCustomAlert y showErrorAlert se mantiene sin cambios) ...
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "🔔";
        alert.querySelector(".alert-icon").style.color = "#ffcc00";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "❌";
        alert.querySelector(".alert-icon").style.color = "#e63946";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }
</script>


@code {
    // ... (El código C# se mantiene sin cambios) ...
    public class TipoSuscripcionModeloValidacion
    {
        [Required(ErrorMessage = "El nombre de la suscripción es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string SuscripcionNombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El precio es obligatorio.")]
        [Range(0.01, 10000.00, ErrorMessage = "El precio debe ser mayor a cero (0) y no exceder 10,000.")]
        public decimal Precio { get; set; }

        [Required(ErrorMessage = "El límite de usuarios/entidades es obligatorio.")]
        [Range(1, 100, ErrorMessage = "El límite debe ser un número entero entre 1 y 100.")]
        public int Limite { get; set; }
    }

    private TipoSuscripcionModeloValidacion modelo = new();

    private async Task Registrar()
    {
        try
        {
            var request = new TipoSuscripcionRequest
            {
                SuscripcionNombre = modelo.SuscripcionNombre,
                Precio = modelo.Precio,
                Limite = modelo.Limite
            };
            var result = await TipoSuscripcionService.CrearTipoSuscripcion(request);

            if (result != null && !string.IsNullOrEmpty(result.message))
            {
                await JS.InvokeVoidAsync("showCustomAlert", $"Tipo de suscripcion registrada: {result.message}");
                await Task.Delay(1800);
                Nav.NavigateTo("/Tipos-suscripcion-index");
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", "No se pudo registrar el Tipo de suscripcio");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error del sistema: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/Tipos-suscripcion-index");
    }
}