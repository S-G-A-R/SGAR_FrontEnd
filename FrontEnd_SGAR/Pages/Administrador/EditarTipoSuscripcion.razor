@page "/editar-tipo-suscripcion/{Id:int}"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.TipoSuscripcionDTO
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject TipoSuscripcionService TipoSuscripcionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="registro-container">
    <div class="registro-card">
        <h3><i class="bi bi-building me-2"></i>Editar tipo de organizacion (ID: @Id)</h3>
        <hr />

        @if (isLoading)
        {
            <p class="text-center"><em>Cargando datos de la organización...</em></p>
        }
        else if (modelo == null)
        {
            <p class="alert alert-danger text-center">No se pudieron cargar los detalles de la organización. (ID no encontrado)</p>
        }

        <EditForm Model="modelo" OnValidSubmit="Actualizar">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="required">Nombre de suscripcion</label>
                <InputText @bind-Value="modelo.SuscripcionNombre" class="form-control" placeholder="Ingresa el nombre la suscripcion" />
                <ValidationMessage For="@(() => modelo.SuscripcionNombre)" />
            </div>

            <div class="form-group">
                <label class="required">Precio</label>
                <InputNumber @bind-Value="modelo.Precio" class="form-control" placeholder="Ingrese el precio" />
                <ValidationMessage For="@(() => modelo.Precio)" />
            </div>

            <div class="form-group">
                <label class="required">limite</label>
                <InputNumber @bind-Value="modelo.Limite" class="form-control" placeholder="Ingresa el limite de prodcutos para agregar" />
                <ValidationMessage For="@(() => modelo.Limite)" />
            </div>

            <div class="botones mt-4 d-flex gap-2 justify-content-center">
                <!-- Botón Crear -->
                <button type="submit" class="btn-buscar" style="width: 150px;">
                    <i class="bi bi-check-circle me-1"></i> Actualizar
                </button>

                <!-- Botón Cancelar -->
                <button type="button" class="btn-limpiar" style="width: 150px;" @onclick="Cancelar">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
            </div>

        </EditForm>

        <!-- ✅ Notificación tipo campana -->
        <div id="successAlert" class="success-alert hidden">
            <div class="alert-box">
                <div class="alert-icon">🔔</div>
                <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
            </div>
        </div>

    </div>
</div>


<style>
    .success-alert {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        transition: all 0.4s ease;
        opacity: 0;
        transform: translateY(-20px);
    }

        .success-alert.show {
            opacity: 1;
            transform: translateY(0);
        }

        .success-alert.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .alert-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        color: #ffcc00;
        animation: ring 0.6s ease-in-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }

    /* BOTÓN BUSCAR */
    .btn-buscar {
        border: 2px solid #000;
        background: #fff;
        color: #10520B;
        width: 50%;
        font-size: 14px;
        border-radius: 6px;
        padding: 7px;
        transition: .2s;
        font-weight: bold; /* ← Aquí se hace negrita */
    }

        .btn-buscar:hover {
            background: #49BFBF;
            color: black;
            transform: scale(1.05);
        }

    /* BOTÓN LIMPIAR */
    .btn-limpiar {
        border: 2px solid #000;
        background: #fff;
        color: #520B0B;
        width: 50%;
        font-size: 14px;
        border-radius: 6px;
        padding: 7px;
        transition: .2s;
        font-weight: bold; /* ← Aquí se hace negrita */
    }

        .btn-limpiar:hover {
            background: #AD3440;
            color: black;
            transform: scale(1.05);
        }
</style>

<script>
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "🔔";
        alert.querySelector(".alert-icon").style.color = "#ffcc00";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "❌";
        alert.querySelector(".alert-icon").style.color = "#e63946";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }
</script>


@code {

    public class EdicionTipoSuscripcionModeloValidacion
    {
        [Required(ErrorMessage = "El nombre de la suscripción es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string SuscripcionNombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El precio es obligatorio.")]
        [Range(0.01, 10000.00, ErrorMessage = "El precio debe ser mayor a cero (0) y no exceder 10,000.")]
        public decimal Precio { get; set; }

        [Required(ErrorMessage = "El límite de usuarios/entidades es obligatorio.")]
        [Range(1, 100, ErrorMessage = "El límite debe ser un número entero entre 1 y 100.")]
        public int Limite { get; set; }
    }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private EdicionTipoSuscripcionModeloValidacion modelo = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            await CargarDatosSuscripcion(Id);
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CargarDatosSuscripcion(int id)
    {
        try
        {
            var suscripcionDto = await TipoSuscripcionService.ObtenerPorId(id);

            if (suscripcionDto != null)
            {
                modelo.SuscripcionNombre = suscripcionDto.SuscripcionNombre;
                modelo.Precio = suscripcionDto.Precio;
                modelo.Limite = suscripcionDto.Limite;
            }
            else
            {
                Console.WriteLine($"Error: Tipo de suscripción con ID {id} no encontrado.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos de suscripción: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Actualizar()
    {
        if (Id == 0) return;
        var requets = new TipoSuscripcionRequest
        {
            SuscripcionNombre = modelo.SuscripcionNombre,
            Precio = modelo.Precio,
            Limite = modelo.Limite
        };
        var resultado = await TipoSuscripcionService.ActualizarTipoSuscripcion(Id, requets);
        if (resultado != null)
        {
            await JS.InvokeVoidAsync("showCustomAlert", "Tipo de suscripción editado con éxito.");
            Nav.NavigateTo("/tipos-suscripcion-index");
        }
        else
        {
            await JS.InvokeVoidAsync("showErrorAlert", "Error al editar el tipo de suscripción. Inténtalo de nuevo.");
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/tipos-suscripcion-index");
    }


}
