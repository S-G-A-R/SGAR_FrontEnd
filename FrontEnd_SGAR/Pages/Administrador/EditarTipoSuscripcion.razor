@page "/editar-tipo-suscripcion/{Id:int}"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.TipoSuscripcionDTO
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject TipoSuscripcionService TipoSuscripcionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="card shadow-lg p-4 custom-form-card">
        
        <h3 class="text-center mb-4 fw-bold text-dark">
            <i class="bi bi-pencil-square me-2"></i> Editar Plan de Suscripción (ID: @Id)
        </h3>
        <hr />

        @if (isLoading)
        {
            <div class="text-center p-5">
                <div class="loader-dots-container d-flex justify-content-center align-items-center mb-3 gap-2">
                    <div class="spinner-grow text-secondary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="spinner-grow text-secondary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="spinner-grow text-secondary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
                <p class="mt-2 text-secondary fw-bold fs-5">Cargando Plan...</p>
            </div>
        }
        else if (modelo == null)
        {
            <p class="alert alert-danger text-center">No se pudieron cargar los detalles del Plan. (ID @Id no encontrado)</p>
        }
        else
        {
            <EditForm Model="modelo" OnValidSubmit="Actualizar">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    
                    <div class="col-12">
                        <div class="form-group">
                            <label class="required fw-semibold">Nombre del Plan</label>
                            <InputText @bind-Value="modelo.SuscripcionNombre" class="form-control" placeholder="Ingresa el nombre la suscripcion" />
                            <ValidationMessage For="@(() => modelo.SuscripcionNombre)" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="required fw-semibold">Precio ($)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                                <InputNumber @bind-Value="modelo.Precio" class="form-control" placeholder="0.00" />
                            </div>
                            <ValidationMessage For="@(() => modelo.Precio)" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="required fw-semibold">Límite de Productos/Entidades</label>
                            <InputNumber @bind-Value="modelo.Limite" class="form-control" placeholder="Límite de productos a agregar" />
                            <ValidationMessage For="@(() => modelo.Limite)" />
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="fw-semibold text-secondary">Fecha de Inicio (Pendiente)</label>
                            <input value="(Funcionalidad Pendiente)" class="form-control bg-light" disabled />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="fw-semibold text-secondary">Fecha de Fin (Pendiente)</label>
                            <input value="(Funcionalidad Pendiente)" class="form-control bg-light" disabled />
                        </div>
                    </div>
                    </div>

                <hr class="mt-4 mb-3" />

                <div class="d-flex gap-3 justify-content-center mt-4">
                    
                    <button type="submit" class="btn btn-primary px-4 py-2 custom-btn-size">
                        <i class="bi bi-check-circle me-1"></i> Actualizar
                    </button>

                    <button type="button" class="btn btn-secondary px-4 py-2 custom-btn-size" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </button>
                </div>

            </EditForm>
        }

        <div id="successAlert" class="success-alert hidden">
            <div class="alert-box">
                <div class="alert-icon">🔔</div>
                <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Estilos de Botones y Formulario (Ajustados para consistencia) */
    .custom-form-card {
        max-width: 600px;
        margin: 40px auto;
        border-radius: 12px;
    }
    
    label.required::after {
        content: " *";
        color: red;
        font-weight: bold;
    }

    .custom-btn-size {
        min-width: 150px;
        font-weight: 600;
        border-radius: 8px;
        transition: transform 0.1s;
    }

    .custom-btn-size:hover {
        transform: translateY(-2px);
    }
    
    /* Estilos de la Alerta (Mantenidos) */
    .success-alert {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        transition: all 0.4s ease;
        opacity: 0;
        transform: translateY(-20px);
    }

    .success-alert.show {
        opacity: 1;
        transform: translateY(0);
    }

    .success-alert.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .alert-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        color: #ffcc00;
        animation: ring 0.6s ease-in-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
    

</style>


<script>
    // Se mantienen las funciones showCustomAlert y showErrorAlert
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "🔔";
        alert.querySelector(".alert-icon").style.color = "#ffcc00";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "❌";
        alert.querySelector(".alert-icon").style.color = "#e63946";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }
</script>


@code {

    public class EdicionTipoSuscripcionModeloValidacion
    {
        [Required(ErrorMessage = "El nombre de la suscripción es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string SuscripcionNombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El precio es obligatorio.")]
        [Range(0.01, 10000.00, ErrorMessage = "El precio debe ser mayor a cero (0) y no exceder 10,000.")]
        public decimal Precio { get; set; }

        [Required(ErrorMessage = "El límite de usuarios/entidades es obligatorio.")]
        [Range(1, 100, ErrorMessage = "El límite debe ser un número entero entre 1 y 100.")]
        public int Limite { get; set; }
    }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private EdicionTipoSuscripcionModeloValidacion modelo = new();
    
  
    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            await CargarDatosSuscripcion(Id);
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CargarDatosSuscripcion(int id)
    {
        try
        {
            var suscripcionDto = await TipoSuscripcionService.ObtenerPorId(id);

            if (suscripcionDto != null)
            {
                modelo.SuscripcionNombre = suscripcionDto.SuscripcionNombre;
                modelo.Precio = suscripcionDto.Precio;
                modelo.Limite = suscripcionDto.Limite;
            }
            else
            {
                modelo = null; // Esto dispara el mensaje de error en el Razor
                await JS.InvokeVoidAsync("showErrorAlert", $"Error: Plan con ID {id} no encontrado.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos de suscripción: {ex.Message}");
            await JS.InvokeVoidAsync("showErrorAlert", "Error de conexión al cargar el Plan.");
            modelo = null; // Esto dispara el mensaje de error en el Razor
        }
        finally
        {
            isLoading = false;
        }
    }

  
    private async Task Actualizar()
    {
        try
        {
            if (Id == 0) return;
            var requets = new TipoSuscripcionRequest
            {
                SuscripcionNombre = modelo.SuscripcionNombre,
                Precio = modelo.Precio,
                Limite = modelo.Limite
            };
            var resultado = await TipoSuscripcionService.ActualizarTipoSuscripcion(Id, requets);
            
            if (resultado != null && !string.IsNullOrEmpty(resultado.message))
            {
                await JS.InvokeVoidAsync("showCustomAlert", $"Plan editado con éxito: {resultado.message}");
                await Task.Delay(500);
                Nav.NavigateTo("/tipos-suscripcion-index");
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", "Error al editar el Plan. Inténtalo de nuevo.");
            }
        }
        catch (Exception ex)
        {
             await JS.InvokeVoidAsync("showErrorAlert", $"Error del sistema al actualizar: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/tipos-suscripcion-index");
    }
}