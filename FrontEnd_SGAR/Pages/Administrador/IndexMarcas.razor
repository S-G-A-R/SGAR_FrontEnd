@page "/index-marcas"
@using FrontEnd_SGAR.DTOs
@using FrontEnd_SGAR.Providers
@using FrontEnd_SGAR.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject MarcaService MarcaService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject CustomAuthStateProvider AuthStateProvider
@inject IJSRuntime JS


<h3 class="titulo-gestion">Gestión de Marcas</h3>

<!-- ======= FILTROS ======= -->
<div class="filtros-card shadow-sm p-3 mb-4 rounded">

    <div class="row g-3">

        <!-- FILTRO NOMBRE -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Nombre</label>
            <input type="text"
                   class="form-control"
                   placeholder="Buscar nombre..."
                   @bind="FiltroNombre"
                   @bind:event="oninput" />
        </div>

        <!-- FILTRO MODELO -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Modelo</label>
            <input type="text"
                   class="form-control"
                   placeholder="Buscar modelo..."
                   @bind="FiltroModelo"
                   @bind:event="oninput" />
        </div>

        <!-- FILTRO AÑO (AUTOCOMPLETADO) -->

        <div class="col-md-4">
            <label class="form-label fw-semibold">Año de fabricación</label>

            <div class="autocomplete-container" style="position: relative;">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar año..."
                       value="@YearFilter"
                       @oninput="OnYearInput"
                       @onfocus="() => MostrarDropdown = true"
                       @onblur="OnYearBlur" />

                @if (MostrarDropdown && AñosFiltrados.Count > 0)
                {
                    <div class="autocomplete-dropdown">
                        @foreach (var año in AñosFiltrados)
                        {
                            <div class="autocomplete-item"
                                 @onclick="() => SeleccionarAño(año)">
                                @año
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- BOTONES -->
    <div class="d-flex justify-content-end mt-3 gap-2">
        <button class="btn btn-secondary boton-limpiar" @onclick="LimpiarFiltros">
            Limpiar
        </button>
        <button class="btn btn-primary boton-buscar" @onclick="Buscar">
            Buscar
        </button>
    </div>
</div>



<!-- ======= SELECTOR DE PAGE SIZE ======= -->
<div class="d-flex justify-content-between align-items-center mb-3">

    <!-- ======= BOTÓN CREAR ======= -->
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-success boton-crear" @onclick='() => Nav.NavigateTo("/marcas-crear")'>
            <i class="bi bi-plus-circle"></i>  Crear Marca
        </button>
    </div>
    <div>
        <label class="me-2 fw-semibold">Mostrar:</label>

        <select class="form-select d-inline-block"
                style="width: 120px;"
                @onchange="OnPageSizeChanged">
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="0">Todos</option>
        </select>
    </div>
</div>


<!-- ======= TABLA ======= -->
<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover tabla-modern">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Modelo</th>
                <th>Año</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @if (Cargando)
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        Cargando...
                    </td>
                </tr>
            }
            else if (!ListaMarcas.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        No se encontraron registros
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in ListaMarcas)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Modelo</td>
                        <td>@item.YearOfFabrication</td>

                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick='() => Nav.NavigateTo($"/marcas-editar/{item.Id}")'>
                                <i class="bi bi-pencil"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ConfirmarEliminar(item.Id)">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- ======= PAGINACIÓN ======= -->
@if (TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(PageNumber == 0 ? "disabled" : "")">
                <a class="page-link" @onclick="()=>CambiarPagina(PageNumber - 1)">Anterior</a>
            </li>

            @for (int i = 0; i < TotalPages; i++)
            {
                <li class="page-item @(PageNumber == i ? "active" : "")">
                    <a class="page-link" @onclick="()=>CambiarPagina(i)">@i</a>
                </li>
            }

            <li class="page-item @(PageNumber == TotalPages - 1 ? "disabled" : "")">
                <a class="page-link" @onclick="()=>CambiarPagina(PageNumber + 1)">Siguiente</a>
            </li>

        </ul>
    </nav>
}

<!-- ======= MODAL ELIMINAR ======= -->
@if (MostrarModal)
{
    <div class="modal-backdrop-custom"></div>

    <div class="modal-card shadow-lg">

        <!-- ENCABEZADO -->
        <div class="modal-card-header">
            <h5>Eliminar Marca</h5>
        </div>

        <!-- CUERPO -->
        <div class="modal-card-body">

            <p class="fw-semibold text-center">¿Está seguro que desea eliminar este registro?</p>

            <!-- DATOS DEL REGISTRO -->
            <div class="modal-info-box">
                <p><strong>ID:</strong> @MarcaSeleccionada?.Id</p>
                <p><strong>Nombre:</strong> @MarcaSeleccionada?.Nombre</p>
                <p><strong>Modelo:</strong> @MarcaSeleccionada?.Modelo</p>
                <p><strong>Año:</strong> @MarcaSeleccionada?.YearOfFabrication</p>
            </div>

            <!-- BOTONES -->
            <div class="text-end mt-3">
                <button class="btn btn-cancelar me-2" @onclick="() => MostrarModal = false">
                    Cancelar
                </button>

                <button class="btn btn-eliminar" @onclick="Eliminar">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

