@code {
    // Filtros
    string? FiltroNombre { get; set; } = "";
    string? FiltroModelo { get; set; } = "";
    string? YearFilter { get; set; } = "";
    bool Cargando = true;

    // Datos
    List<MarcaDTO.MarcaDetalleDto> ListaMarcas = new();
    MarcaDTO.MarcaDetalleDto? MarcaSeleccionada;

    // Autocomplete
    bool MostrarDropdown = false;
    List<int> AñosFiltrados = new();

    List<int> ListaAños = Enumerable.Range(1900, 2100 - 1900 + 1).ToList();

    // Paginación
    int PageNumber = 0;
    int PageSize = 10;
    int TotalPages = 1;

    // Modal
    bool MostrarModal = false;
    int IdEliminar = 0;


    protected override async Task OnInitializedAsync()
    {
        AñosFiltrados = ListaAños;
        await Buscar();
    }

    async void OnYearBlur()
    {
        // Espera un poquito para permitir hacer clic en una opción
        await Task.Delay(200);

        if (!ListaAños.Contains(int.TryParse(YearFilter, out var y) ? y : -1))
            YearFilter = "";

        MostrarDropdown = false;

        StateHasChanged(); // fuerza refresco

    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (value == "0")
        {
            PageSize = 999999; // TODOS
        }
        else
        {
            PageSize = int.Parse(value);
        }

        PageNumber = 0; // reiniciar paginación
        await Buscar();
    }


    async Task Buscar()
    {
        Cargando = true;

        string? yearParam = YearFilter;

        var response = await MarcaService.ObtenerMarcasAsync(
            PageNumber, PageSize,
            FiltroNombre,
            FiltroModelo,
            yearParam
        );

        if (response != null)
        {
            ListaMarcas = response.Content;
            TotalPages = response.TotalPages;

            if (ListaMarcas.Count == 0)
            {
                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    title = "Sin resultados",
                    text = "No se encontraron registros.",
                    icon = "info"
                });
            }
        }

        Cargando = false;
    }



    async Task LimpiarFiltros()
    {
        FiltroNombre = "";
        FiltroModelo = "";
        YearFilter = "";

        PageNumber = 0;
        MostrarDropdown = false;

        await Buscar();
    }



    void CambiarPagina(int page)
    {
        PageNumber = page;
        Buscar();
    }


    // Autocompletado
    void OnYearInput(ChangeEventArgs e)
    {
        YearFilter = e.Value?.ToString();
        MostrarDropdown = true;

        if (string.IsNullOrWhiteSpace(YearFilter))
        {
            AñosFiltrados = ListaAños;
            return;
        }

        AñosFiltrados = ListaAños
            .Where(a => a.ToString().Contains(YearFilter))
            .ToList();
    }


 

    void SeleccionarAño(int año)
    {
        YearFilter = año.ToString();
        MostrarDropdown = false;
    }


    // Modal y eliminar
    void ConfirmarEliminar(int id)
    {
        IdEliminar = id;
        MarcaSeleccionada = ListaMarcas.FirstOrDefault(x => x.Id == id);
        MostrarModal = true;
    }

    async Task Eliminar()
    {
        await MarcaService.EliminarMarcaAsync(IdEliminar);
        MostrarModal = false;
        await Buscar();
    }
}

