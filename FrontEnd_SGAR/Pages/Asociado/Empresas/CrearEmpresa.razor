@page "/asociado/empresas/crearEmpresa"
@inject NavigationManager Navigation


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="text-center mb-4">Crear Empresa</h3>

                    <EditForm Model="@empresa" OnValidSubmit="GuardarEmpresa">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <InputText id="nombre" class="form-control" @bind-Value="empresa.Nombre" required />
                        </div>

                        <div class="mb-3">
                            <label for="nit" class="form-label">NIT</label>
                            <InputText id="nit" class="form-control" @bind-Value="empresa.Nit" required />
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-2"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-secondary px-4" @onclick="Cancelar">
                                <i class="bi bi-x-circle me-2"></i> Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private Empresa empresa = new();

    private void GuardarEmpresa()
    {
        // Aquí luego irá la llamada al API para guardar
        Console.WriteLine($"Guardado: {empresa.Nombre} - {empresa.Nit}");
        Navigation.NavigateTo("/empresas");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/asociados/empresas/indexEmpresa");
    }

    public class Empresa
    {
        public string Nombre { get; set; } = string.Empty;
        public string Nit { get; set; } = string.Empty;
    }
}