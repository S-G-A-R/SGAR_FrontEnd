@page "/empresa-editar/{id:int}"
@using FrontEnd_SGAR.Providers
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject EmpresaService EmpresaService
@attribute [Authorize]
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div id="successAlert" class="custom-alert hidden">
    <div class="alert-box">
        <div class="alert-icon" id="alertIcon">🔔</div>
        <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card p-4 shadow-lg form-card">

                <h3 class="card-title text-center fw-bold mb-4">
                    <i class="bi bi-pencil-square me-2 text-primary"></i> Editar Empresa
                </h3>
                <hr class="mb-4" />

                @if (isLoading)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-2 text-primary fw-bold">Cargando datos de la empresa...</p>
                    </div>
                }
                else
                {
                    <EditForm Model="modelo" OnValidSubmit="Actualizar" class="needs-validation" novalidate>
                        <DataAnnotationsValidator />

                        <div class="form-group mb-4">
                            <label class="form-label fw-semibold required" for="nombreEmpresa">Nombre de la empresa</label>
                            <InputText id="nombreEmpresa" @bind-Value="modelo.NombreEmpresa" class="form-control form-control-lg" placeholder="Ingresa el nombre de la empresa" />
                            <ValidationMessage For="@(() => modelo.NombreEmpresa)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5">
                            
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-bold" @onclick="Cancelar">
                                Cancelar
                            </button>

                            <button type="submit" class="btn btn-primary btn-actualizar px-5 py-2 fw-bold" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Actualizando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-2"></i>
                                    <span>Actualizar</span>
                                }
                            </button>
                        </div>

                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos del Card Principal */
    .form-card {
        border-radius: 1rem;
        border: 1px solid #dee2e6; 
    }

    /* Estilos del Formulario */
    .form-group label.required:after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }

    .form-control-lg {
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    /* Estilo del Botón Actualizar */
    .btn-actualizar {
        background-color: #007bff; /* Azul primario */
        border-color: #007bff;
        transition: background-color 0.2s, transform 0.2s;
    }
    .btn-actualizar:hover:not(:disabled) {
        background-color: #0056b3;
        border-color: #004085;
        transform: translateY(-1px);
    }
    .btn-actualizar:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    /* --- Estilos de la Alerta (Sin Keyframes) --- */
    .custom-alert {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 0;
    }

    .custom-alert.show {
        opacity: 1;
        transform: translateX(-50%) translateY(10px);
    }

    .custom-alert.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .alert-box {
        background: #ffffff;
        border-radius: 15px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
    }

    .alert-icon.pulse {
        /* Clase de animación que el JS intentará aplicar */
        transition: transform 0.15s ease-in-out;
    }
    .alert-icon.pulse:active {
        transform: scale(1.1);
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
</style>

<script>
    // Se adaptan las funciones JS para usar el ID 'alertIcon' y evitar keyframes
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "🔔";
        icon.style.color = "#ffcc00"; 
        icon.classList.add("pulse"); 

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
            icon.classList.remove("pulse"); 
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "❌";
        icon.style.color = "#e63946"; 
        icon.classList.add("pulse"); 

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
            icon.classList.remove("pulse"); 
        }, 3000);
    }
</script>

@code {

    public class EmpresaModelValidacion
    {
        public int AsociadoId { get; set; }

        [Required(ErrorMessage = "El nombre de la empresa es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string NombreEmpresa { get; set; } = string.Empty;
    }

    [Parameter]
    public int id { get; set; }
    private bool isLoading = true;

    private EmpresaModelValidacion modelo = new();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
        {
            await CargarDatosEmpresa(id);
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CargarDatosEmpresa(int id)
    {
        try
        {
            var empresaDto = await EmpresaService.ObtenerPorId(id);

            if (empresaDto != null)
            {
                modelo.AsociadoId = empresaDto.AsociadoId;
                modelo.NombreEmpresa = empresaDto.NombreEmpresa;
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", $"Empresa con ID {id} no encontrada.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Actualizar()
    {
        if (id == 0) return;

        isSubmitting = true;
        StateHasChanged();

        var requets = new EmpresaRequest
        {
            AsociadoId = modelo.AsociadoId,
            NombreEmpresa = modelo.NombreEmpresa
        };

        try
        {
            var resultado = await EmpresaService.ActualizarEmpresa(id, requets);

            if (resultado != null)
            {
                await JS.InvokeVoidAsync("showCustomAlert", "Empresa editada con éxito.");

                // ⭐ SOLUCIÓN CLAVE: Forzar la recarga de la página de índice para actualizar la lista.
                Nav.NavigateTo("/empresa-index", forceLoad: true);
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", "Error al editar la empresa. Inténtalo de nuevo.");
            }
        }
        catch (Exception ex)
        {
             await JS.InvokeVoidAsync("showErrorAlert", $"Error al actualizar la empresa: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/empresa-index");
    }
}