@page "/empresa-index"
@using FrontEnd_SGAR.Providers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Nav
@inject CustomAuthStateProvider AuthStateProvider


<link rel="stylesheet" href="css/index-organizacion.css" />

<div class="container mt-4">

     <h2 class="title-page text-center mb-4">Gestión de empresa</h2>

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-danger" @onclick="CerrarSesion">
            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">

        <!-- IZQUIERDA: Crear -->
        <button class="btn btn-crear"
                @onclick='() => Nav.NavigateTo("/empresa-crear")'>
            <i class="bi bi-plus-circle"></i> Crear nueva empresa
        </button>

       @*  <!-- DERECHA: Mostrar -->
        <div class="d-flex align-items-center gap-2">
            <label class="fw-semibold">Mostrar:</label>
            <select class="form-select form-select-sm w-auto" @onchange="CambiarPageSize">
                <option value="5">5</option>
                <option selected value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
 *@
    </div>


</div>

@code {


     private async Task CerrarSesion()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login-admin", true);
    }
}
