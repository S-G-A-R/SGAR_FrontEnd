@page "/empresa-crear"
@using FrontEnd_SGAR.Providers
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject EmpresaService EmpresaService
@attribute [Authorize]
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div id="successAlert" class="custom-alert hidden">
    <div class="alert-box">
        <div class="alert-icon" id="alertIcon">🔔</div>
        <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
    </div>
</div>


<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card p-4 shadow-lg form-card">

                <h3 class="card-title text-center fw-bold mb-4">
                    <i class="bi bi-buildings me-2 text-primary"></i> Registrar Empresa
                </h3>
                <hr class="mb-4" />

                <EditForm Model="modelo" OnValidSubmit="Registrar" class="needs-validation" novalidate>
                    <DataAnnotationsValidator />

                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold required" for="nombreEmpresa">Nombre de la empresa</label>
                        <InputText id="nombreEmpresa" @bind-Value="modelo.NombreEmpresa" class="form-control form-control-lg" placeholder="Ingresa el nombre de la empresa" />
                        <ValidationMessage For="@(() => modelo.NombreEmpresa)" class="text-danger small mt-1" />
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5">
                        
                        <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-bold" @onclick="Cancelar">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-primary btn-registrar px-5 py-2 fw-bold" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Registrando...</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle me-2"></i>
                                <span>Registrar</span>
                            }
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos del Card Principal */
    .form-card {
        border-radius: 1rem;
        border: 1px solid #dee2e6;
    }

    /* Estilos del Formulario */
    .form-group label.required:after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }

    .form-control-lg {
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    /* Estilo del Botón Registrar */
    .btn-registrar {
        background-color: #007bff; /* Azul primario */
        border-color: #007bff;
        transition: background-color 0.2s, transform 0.2s;
    }
    .btn-registrar:hover:not(:disabled) {
        background-color: #0056b3;
        border-color: #004085;
        transform: translateY(-1px);
    }
    .btn-registrar:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    /* --- Estilos de la Alerta (Mantenidos) --- */
    .custom-alert {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 0;
    }

    .custom-alert.show {
        opacity: 1;
        transform: translateX(-50%) translateY(10px);
    }

    .custom-alert.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .alert-box {
        background: #ffffff;
        border-radius: 15px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        /* La animación se maneja con la clase .pulse */
    }

    /* CLASES DE ANIMACIÓN SIMPLE (Reemplazando keyframes) */
    .alert-icon.pulse {
        animation: pulse-simple 0.6s ease-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
</style>

<script>
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "🔔";
        icon.style.color = "#ffcc00"; // Éxito
        icon.classList.add("pulse"); // Aplicar clase de animación

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
            icon.classList.remove("pulse"); // Limpiar animación
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "❌";
        icon.style.color = "#e63946"; // Error
        icon.classList.add("pulse"); // Aplicar clase de animación

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
            icon.classList.remove("pulse"); // Limpiar animación
        }, 3000);
    }
</script>

@code {

    // Se asume la existencia de EmpresaRequest, EmpresaService y EmpresaDTO

    public class EmpresaModelValidacion
    {
        [Required(ErrorMessage = "El nombre de la empresa es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string NombreEmpresa { get; set; } = string.Empty;
    }

    private EmpresaModelValidacion modelo = new();
    private bool isSubmitting = false;

    private async Task Registrar()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
            StateHasChanged(); // Forzar renderizado para mostrar spinner

            var userId = await ObtenerUserIdAsync();
            if (userId == null)
            {
                await JS.InvokeVoidAsync("showErrorAlert", "No se pudo identificar el usuario. Por favor, inicie sesión nuevamente.");
                return;
            }

            var request = new EmpresaRequest
            {
                NombreEmpresa = modelo.NombreEmpresa,
                AsociadoId = userId.Value
            };
            var resultado = await EmpresaService.CrearEmpresa(request);

            if (resultado != null && !string.IsNullOrEmpty(resultado.message))
            {
                await JS.InvokeVoidAsync("showCustomAlert", $"Empresa registrada: {resultado.message}");
                
                // Redirigir al index de empresas
                Nav.NavigateTo("/empresa-index"); 
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", "Error: El servidor no proporcionó detalles del registro.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error crítico: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/empresa-index");
    }

    private async Task<int?> ObtenerUserIdAsync()
    {
        var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

        if (string.IsNullOrEmpty(userIdString) || !int.TryParse(userIdString, out int userId))
        {
            return null;
        }

        return userId;
    }
}