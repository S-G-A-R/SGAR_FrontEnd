@page "/categoria-editar/{id:int}"
@using FrontEnd_SGAR.Providers
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject CategoriaService CategoriaService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<link href="css/registro-organizacion.css" rel="stylesheet" />


<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card p-4 shadow-lg form-card">

                <h3 class="card-title text-center fw-bold mb-4">
                    <i class="bi bi-collection-fill"></i> Editar Categoría
                </h3>
                <hr class="mb-4" />

                @if (isLoading)
                {

                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-2 text-primary fw-bold">Cargando datos de la categorias...</p>
                    </div>
                }
                else
                {
                    <EditForm Model="modelo" OnValidSubmit="Actualizar">
                        <DataAnnotationsValidator />

                        <div class="form-group mb-3">
                            <label class="form-label fw-semibold required">Nombre de la categoría</label>
                            <InputText @bind-Value="modelo.nombreCat" class="form-control form-control-lg" placeholder="Ingresa el nombre de la categoría" />
                            <ValidationMessage For="@(() => modelo.nombreCat)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-bold" @onclick="Cancelar">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-registrar px-4 py-2 fw-bold" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Actualizando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-2"></i>
                                    <span>Actualizar</span>
                                }
                            </button>
                        </div>

                    </EditForm>
                }
            </div>

            <div id="successAlert" class="custom-alert hidden">
                <div class="alert-box">
                    <div class="alert-icon" id="alertIcon">🔔</div>
                    <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Estilos del Card Principal */
    .form-card {
        border-radius: 1rem;
        border: 1px solid #dee2e6;
    }

    /* Estilos del Formulario */
    .form-group label.required:after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }

    .form-control-lg {
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }

    /* Estilo del Botón Actualizar */
    .btn-actualizar {
        background-color: #007bff; /* Azul primario */
        border-color: #007bff;
        transition: background-color 0.2s, transform 0.2s;
    }

        .btn-actualizar:hover:not(:disabled) {
            background-color: #0056b3;
            border-color: #004085;
            transform: translateY(-1px);
        }

        .btn-actualizar:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* --- Estilos de la Alerta (Sin Keyframes) --- */
    .custom-alert {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 0;
    }

        .custom-alert.show {
            opacity: 1;
            transform: translateX(-50%) translateY(10px);
        }

        .custom-alert.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .alert-box {
        background: #ffffff;
        border-radius: 15px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
    }

        .alert-icon.pulse {
            /* Clase de animación que el JS intentará aplicar */
            transition: transform 0.15s ease-in-out;
        }

            .alert-icon.pulse:active {
                transform: scale(1.1);
            }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
</style>

<script>
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "🔔";
        icon.style.color = "#ffcc00";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");
        const icon = document.getElementById("alertIcon");

        icon.textContent = "❌";
        icon.style.color = "#e63946";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }
</script>

@code {
    public class CategoriaModelValidacion
    {
        public int asociadoId { get; set; }

        [Required(ErrorMessage = "El nombre de la categoria es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre de la categoria no debe exceder los 100 caracteres.")]
        public string nombreCat { get; set; } = string.Empty;
    }

    private CategoriaModelValidacion modelo = new();

    [Parameter]
    public int id { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (id != 0)
        {
            await CargarDatosCategoriaProducto(id);
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task CargarDatosCategoriaProducto(int id)
    {
        try
        {
            var categoriaProductoDTO = await CategoriaService.ObtenerPorId(id);

            if (categoriaProductoDTO != null)
            {
                modelo.asociadoId = categoriaProductoDTO.asociadoId;
                modelo.nombreCat = categoriaProductoDTO.nombreCat;
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", $"Categoria con ID {id} no encontrada.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error al cargar categoria: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Actualizar()
    {
        if (id == 0) return;

        if (isSubmitting) return;
        isSubmitting = true;
        StateHasChanged();

        var requets = new CategoriaRequest
        {
            asociadoId = modelo.asociadoId,
            nombreCat = modelo.nombreCat
        };

        try
        {
            var resultado = await CategoriaService.ActualizarCategoria(id, requets);
            if (resultado != null)
            {
                await JS.InvokeVoidAsync("showCustomAlert", "Categoría editada con éxito.");
                await Task.Delay(1000);
                Nav.NavigateTo("/categoria-index");
            }
            else
            {
                await JS.InvokeVoidAsync("showErrorAlert", "Error al editar la categoría. Inténtalo de nuevo.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error al actualizar la categoría: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/categoria-index");
    }
}
