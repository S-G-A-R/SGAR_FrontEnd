@page "/index-organizacion"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using FrontEnd_SGAR.Providers
@using static FrontEnd_SGAR.DTOs.MunicipioDTO
@using static FrontEnd_SGAR.DTOs.OrganizacionDTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrganizacionService OrganizacionService
@inject MunicipioService MunicipioService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<link rel="stylesheet" href="css/index-organizacion.css" />

    <a href="#" class="text-primary fs-3 me-2">
        <i class="bi bi-arrow-left-circle"></i>
    </a>

<div class="container mt-4">

    <h2 class="title-page text-center mb-4">Gestión de Organizaciones</h2>


    <!-- BUSCADOR -->
    <div class="row g-3 align-items-end mb-3 search-section">

        <!-- FILTRO NOMBRE -->
        <div class="col-md-3">
            <label class="form-label">Nombre:</label>
            <input class="form-control" placeholder="Nombre..."
                   @bind="filtros.NombreOrganizacion" />
        </div>

        <!-- FILTRO TELÉFONO -->
        <div class="col-md-2">
            <label class="form-label">Teléfono:</label>
            <input class="form-control" placeholder="Teléfono..."
                   @bind="filtros.Telefono" />
        </div>

        <!-- FILTRO EMAIL -->
        <div class="col-md-3">
            <label class="form-label">Email:</label>
            <input type="email" class="form-control"
                   placeholder="Email..."
                   @bind="filtros.Email" />
        </div>

        <!-- FILTRO MUNICIPIO -->
        <div class="col-md-2">
            <label class="form-label">Municipio:</label>
            <select class="form-select"
                    @bind="filtros.IdMunicipio">
                <option value="">Todos</option>
                @foreach (var muni in municipiosDict)
                {
                    <option value="@muni.Key">@muni.Value</option>
                }
            </select>
        </div>

        <!-- BOTONES -->
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button class="btn btn-buscar w-100" @onclick="BuscarOrganizaciones">
                <i class="bi bi-search"></i> Buscar
            </button>

            <button class="btn btn-limpiar w-100" @onclick="LimpiarFiltros">
                <i class="bi bi-eraser"></i> Limpiar
            </button>
        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">

        <button class="btn btn-crear"
                @onclick='() => Nav.NavigateTo("/organizacion-crear")'>
            <i class="bi bi-plus-circle"></i> Crear Organización
        </button>

        <div class="d-flex align-items-center gap-2">
            <label class="fw-semibold">Mostrar:</label>
            <select class="form-select form-select-sm w-auto" @onchange="CambiarPageSize">
                <option value="5">5</option>
                <option selected value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>

    </div>


    @if (isLoading)
    {
        <div class="text-center p-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (response == null || !response.Items.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay organizaciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Organización</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Municipio</th>
                        <th>Notificación</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var org in response.Items)
                    {
                        <tr>
                            <td>@org.Id</td>
                            <td>@org.Nombre</td>
                            <td>@org.telefono</td>
                            <td>@org.email</td>
                            <td>
                                @(municipiosDict.ContainsKey(org.idMunicipio)
                                    ? municipiosDict[org.idMunicipio]
                                    : "No encontrado")
                            </td>
                            <td class="text-start">
                                @{
                                    string notif = org.notificacion ?? "000";
                                    bool notifProx = notif.Length > 0 && notif[0] == '1';
                                    bool notifInicio = notif.Length > 1 && notif[1] == '1';
                                    bool notifTiempo = notif.Length > 2 && notif[2] == '1';
                                }

                                <div class="d-flex flex-column small">
                                    <span class="d-flex align-items-center">
                                        <i class="@(notifProx ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-1"></i>
                                        Proximidad
                                    </span>

                                    <span class="d-flex align-items-center">
                                        <i class="@(notifInicio ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-1"></i>
                                        Inicio ruta
                                    </span>

                                    <span class="d-flex align-items-center">
                                        <i class="@(notifTiempo ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-1"></i>
                                        Tiempo real
                                    </span>
                                </div>
                            </td>
                            <td>@(org.idRol == 5 ? "Organización" : "Otro")</td>
                            <td class="text-center">
                                <div class="btn-group gap-1">
                                    <button class="btn btn-sm btn-outline-info" title="Ver" @onclick="() => Ver(org.Id)">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>

                                    <button class="btn btn-sm btn-outline-warning" title="Editar" @onclick="() => Editar(org.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(org.Id)">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN -->
        <div class="pagination-container mt-3 d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(!response.HasPreviousPage)"
                    @onclick="PrevPage">
                ◀ Anterior
            </button>

            <span class="fw-bold page-info">
                Página @response.PageNumber de @response.TotalPages | Total: @response.TotalCount organizaciones
            </span>

            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(!response.HasNextPage)"
                    @onclick="NextPage">
                Siguiente ▶
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
        </div>
    }
</div>

<style>
    .title-page {
        font-family: 'Lilita One', sans-serif;
        font-size: 32px;
        font-weight: normal; /* evita que se engrose demasiado */
        color: #050303; /* moradito suave, puedes cambiar */
        letter-spacing: 1px;
    }

    .custom-table thead {
        background-color: #050303;
        color: white;
        text-align: center;
    }

    .custom-table th,
    .custom-table td {
        vertical-align: middle;
        padding: 12px;
        font-size: 14px;
    }

    .custom-table tbody tr:hover {
        background-color: #EEEEEE;
        transition: 0.2s ease-in-out;
    }

    .btn-group .btn {
        padding: 4px 8px;
        font-size: 12px;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

    .page-info {
        color: #050303;
        font-size: 15px;
    }

    /* media query corregida y con llaves equilibradas */
    @@media (max-width: 768px) {
        .custom-table th, .custom-table td

    {
        font-size: 12px;
        padding: 6px;
    }

    }

    .btn-group .btn i {
        font-size: 16px;
    }

    .btn-outline-info {
        color: #0dcaf0;
        border-color: #0dcaf0;
    }

    .btn-outline-warning {
        color: #ffc107;
        border-color: #ffc107;
    }

    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
    }

        .btn-outline-info:hover,
        .btn-outline-warning:hover,
        .btn-outline-danger:hover {
            color: white;
        }

    /* BOTÓN BUSCAR */
    .btn-buscar {
        border: 2px solid #000;
        background: #fff;
        color: #000;
        width: 50%;
        font-size: 14px;
        border-radius: 6px;
        padding: 7px;
        transition: .2s;
    }

        .btn-buscar:hover {
            background: #BABABA;
            color: black;
            transform: scale(1.05);
        }

    /* BOTÓN LIMPIAR */
    .btn-limpiar {
        border: 2px solid #000;
        background: #fff;
        color: #8d44ad;
        width: 50%;
        font-size: 14px;
        border-radius: 6px;
        padding: 7px;
        transition: .2s;
    }

        .btn-limpiar:hover {
            background: #D9C7FF;
            color: black;
            transform: scale(1.05);
        }

    /* BOTÓN CREAR */
    .btn-crear {
        border: 2px solid #000;
        background: #fff;
        color: #2e7d32;
        font-size: 14px;
        font-weight: 600;
        border-radius: 6px;
         transition: .2s;
        width: auto; /* que se adapte al contenido */
        padding: 6px 12px; /* puedes ajustarlo */
    }

        .btn-crear:hover {
            background: #5C9E77;
            color: white;
            transform: scale(1.05);
        }
 

</style>

@code {
    public class FiltroOrganizacion
    {
        public string? NombreOrganizacion { get; set; }
        public string? Telefono { get; set; }
        public string? Email { get; set; }
        public string? IdMunicipio { get; set; }
    }
    
    private FiltroOrganizacion filtros = new();
    private OrganizacionResponsePaginada? response;
    private Dictionary<string, string> municipiosDict = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 10;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[IndexOrganizacion] Iniciando carga de organizaciones...");
        await CargarMunicipios();
        await CargarOrganizaciones();
    }

    private async Task CargarMunicipios()
    {
        try
        {
            var municipios = await MunicipioService.ObtenerMunicipiosAsync();
            municipiosDict = municipios.ToDictionary(m => m.Id, m => m.Nombre);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[IndexOrganizacion] Error al cargar municipios: {ex.Message}");
            municipiosDict = new Dictionary<string, string>();
        }
    }

    private async Task BuscarOrganizaciones()
    {
        currentPage = 1;
        await CargarOrganizaciones();
    }

    private async Task LimpiarFiltros()
    {
        filtros = new FiltroOrganizacion();
        currentPage = 1;
        await CargarOrganizaciones();
    }

    private async Task CargarOrganizaciones()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            Console.WriteLine($"[IndexOrganizacion] Cargando página {currentPage}, tamaño {pageSize}");

            if (!string.IsNullOrWhiteSpace(filtros.NombreOrganizacion) ||
                !string.IsNullOrWhiteSpace(filtros.Telefono) ||
                !string.IsNullOrWhiteSpace(filtros.Email) ||
                !string.IsNullOrWhiteSpace(filtros.IdMunicipio))
            {
                // Buscar con filtros usando el servicio
                response = await OrganizacionService.BuscarOrganizacionesAsync(
                    filtros.NombreOrganizacion,
                    filtros.Telefono,
                    filtros.Email,
                    filtros.IdMunicipio,
                    currentPage,
                    pageSize);
            }
            else
            {
                // Sin filtros → listar todos usando el servicio
                response = await OrganizacionService.ObtenerOrganizacionesAsync(currentPage, pageSize);
            }

            if (response != null)
            {
                Console.WriteLine($"[IndexOrganizacion] Response recibido - Organizaciones: {response.Items?.Count ?? 0}");
                Console.WriteLine($"[IndexOrganizacion] Total Items: {response.TotalCount}");
                Console.WriteLine($"[IndexOrganizacion] Página actual: {response.PageNumber}");
            }
            else
            {
                errorMessage = "No se pudo obtener la respuesta del servidor";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar organizaciones: {ex.Message}";
            Console.WriteLine($"[IndexOrganizacion] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            Console.WriteLine($"[IndexOrganizacion] Carga finalizada. isLoading={isLoading}");
        }
    }

    private async Task CambiarPageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            pageSize = newSize;
            currentPage = 1;
            await CargarOrganizaciones();
        }
    }

    void Ver(int id) => Nav.NavigateTo($"/organizacion-ver/{id}");
    void Editar(int id) => Nav.NavigateTo($"/organizacion-editar/{id}");
    void Eliminar(int id) => Nav.NavigateTo($"/organizacion-eliminar/{id}");

    private async Task NextPage()
    {
        if (response?.HasNextPage == true)
        {
            currentPage++;
            await CargarOrganizaciones();
        }
    }

    private async Task PrevPage()
    {
        if (response?.HasPreviousPage == true)
        {
            currentPage--;
            await CargarOrganizaciones();
        }
    }

    private async Task CerrarSesion()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login-admin", true);
    }
}







