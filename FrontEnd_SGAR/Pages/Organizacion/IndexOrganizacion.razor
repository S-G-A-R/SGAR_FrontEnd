    }

        .btn-limpiar:hover {
            background: #D9C7FF;
            color: black;
            transform: scale(1.05);
        }

    /* BOTÓN CREAR */
    .btn-crear {
        border: 2px solid #000;
        background: #fff;
        color: #2e7d32;
