@page "/index-organizacion"
@using System.Net.Http.Json
@using FrontEnd_SGAR.Services
@inject MunicipioService MunicipioService
@inject HttpClient Http
@inject NavigationManager Nav

<link rel="stylesheet" href="css/index-organizacion.css" />

<div class="container mt-4">

    <h2 class="title-page text-center mb-4">Gestión de Organizaciones</h2>

    <!-- BUSCADOR -->
    <div class="row g-3 align-items-end mb-3 search-section">

        <!-- FILTRO NOMBRE -->
        <div class="col-md-3">
            <label class="form-label">Nombre:</label>
            <input class="form-control" placeholder="Nombre..."
                   @bind="filtros.NombreOrganizacion" />
        </div>

        <!-- FILTRO TELÉFONO -->
        <div class="col-md-2">
            <label class="form-label">Teléfono:</label>
            <input class="form-control" placeholder="Teléfono..."
                   @bind="filtros.Telefono" />
        </div>

        <!-- FILTRO EMAIL -->
        <div class="col-md-3">
            <label class="form-label">Email:</label>
            <input type="email" class="form-control"
                   placeholder="Email..."
                   @bind="filtros.Email" />
        </div>

        <!-- FILTRO MUNICIPIO -->
        <div class="col-md-2">
            <label class="form-label">Municipio:</label>
            <select class="form-select"
                    @bind="filtros.IdMunicipio">
                <option value="">Todos</option>
                @foreach (var muni in municipiosDict)
                {
                    <option value="@muni.Key">@muni.Value</option>
                }
            </select>
        </div>

        <!-- BOTONES -->
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button class="btn btn-buscar w-100" @onclick="BuscarOrganizaciones">
                <i class="bi bi-search"></i> Buscar
            </button>

            <button class="btn btn-limpiar w-100" @onclick="LimpiarFiltros">
                <i class="bi bi-eraser"></i> Limpiar
            </button>
        </div>
        <!-- BOTONES JUNTOS -->
     @*    <div class="col-md-4 d-flex align-items-end gap-3">
            <button class="btn btn-buscar" @onclick="BuscarPorId">
                <i class="bi bi-search"></i> Buscar
            </button>

            <button class="btn btn-limpiar" @onclick="LimpiarBusqueda">
                <i class="bi bi-eraser"></i> Limpiar
            </button>
        </div> *@

    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">

        <button class="btn btn-crear"
                @onclick='() => Nav.NavigateTo("/organizaciones/crear")'>
            <i class="bi bi-plus-circle"></i> Crear Organización
        </button>

        <div class="d-flex align-items-center gap-2">
            <label class="fw-semibold">Mostrar:</label>
            <select class="form-select form-select-sm w-auto" @onchange="CambiarPageSize">
                <option value="0">Todos</option>
                <option value="5">5</option>
                <option selected value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>

    </div>


    @if (organizaciones == null)
    {
        <p>Cargando...</p>
    }
    else if (!organizaciones.Any())
    {
        <p>No hay organizaciones registradas.</p>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Organización</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Municipio</th>
                        <th>Notificación</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var org in organizaciones)
                    {
                        <tr>
                            <td>@org.Id</td>
                            <td>@org.NombreOrganizacion</td>
                            <td>@org.Telefono</td>
                            <td>@org.Email</td>
                            <td>
                                @(municipiosDict.ContainsKey(org.IdMunicipio)
                                                        ? municipiosDict[org.IdMunicipio]
                                                        : "No encontrado")
                    </td>
                    <td>@org.Notificacion</td>
                    <td>@(org.IdRol == 5 ? "Organización" : "Otro")</td>
                    <td class="text-center">
                        <div class="btn-group gap-1">
                            <button class="btn btn-sm btn-outline-info" title="Ver" @onclick="() => Ver(org.Id)">
                                <i class="bi bi-eye-fill"></i>
                            </button>

                                    <button class="btn btn-sm btn-outline-warning" title="Editar" @onclick="() => Editar(org.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(org.Id)">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                        </div>
                    </td>
                </tr>
                                }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(response is null || !response.HasPreviousPage)"
                    @onclick="PrevPage">
                ◀
            </button>

            <span class="fw-bold page-info">
                Página @pagina de @(response?.TotalPages ?? 1)
            </span>

            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(response is null || !response.HasNextPage)"
                    @onclick="NextPage">
                ▶
            </button>
        </div>
    }
</div>

<style>
