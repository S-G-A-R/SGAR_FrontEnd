    }

        .btn-crear:hover {
            background: #5C9E77;
            color: white;
            transform: scale(1.05);
        }
 

</style>

@code {
    public class FiltroOrganizacion
    {
        public string? NombreOrganizacion { get; set; }
        public string? Telefono { get; set; }
        public string? Email { get; set; }
        public string? IdMunicipio { get; set; }
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 10;
    }
    FiltroOrganizacion filtros = new();


    private List<Organizacion> organizaciones = new();
    private PaginacionOrgResponse? response;
    private Dictionary<string, string> municipiosDict = new();

    private int pagina = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await CargarOrganizaciones();
        var municipios = await MunicipioService.ObtenerMunicipiosAsync();
        municipiosDict = municipios.ToDictionary(m => m.Id, m => m.Nombre);
    }

    private async Task BuscarOrganizaciones()
    {
        pagina = 1;
        await CargarOrganizaciones();
    }

    private async Task LimpiarFiltros()
    {
        filtros = new FiltroOrganizacion();
        pagina = 1;
        await CargarOrganizaciones();
    }

    private async Task CargarOrganizaciones()
    {
        filtros.Page = pagina;
        filtros.PageSize = pageSize;

        // Construir query string
        var query = $"nombreOrganizacion={filtros.NombreOrganizacion}&telefono={filtros.Telefono}&email={filtros.Email}&idMunicipio={filtros.IdMunicipio}&page={pagina}&pageSize={pageSize}";

        if (!string.IsNullOrWhiteSpace(filtros.NombreOrganizacion) ||
            !string.IsNullOrWhiteSpace(filtros.Telefono) ||
            !string.IsNullOrWhiteSpace(filtros.Email) ||
            !string.IsNullOrWhiteSpace(filtros.IdMunicipio))
        {
            // Buscar usando filtros
            response = await Http.GetFromJsonAsync<PaginacionOrgResponse>($"api/organization/search?{query}");
        }
        else
        {
            // Sin filtros → listar todos
            response = await Http.GetFromJsonAsync<PaginacionOrgResponse>($"api/organization/list?page={pagina}&pageSize={pageSize}");
        }

        organizaciones = response?.Items ?? new();
    }


    private async Task CambiarPageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            pageSize = newSize == 0 ? response?.TotalCount ?? 10000 : newSize;
            pagina = 1;
            await CargarOrganizaciones();
        }
    }


    void Ver(int id) => Nav.NavigateTo($"/organizaciones/ver/{id}");
    void Editar(int id) => Nav.NavigateTo($"/organizaciones/editar/{id}");
    void Eliminar(int id) => Nav.NavigateTo($"/organizaciones/eliminar/{id}");

    private async Task NextPage()
    {
        if (response?.HasNextPage == true)
        {
            pagina++;
            await CargarOrganizaciones();
        }
    }

    private async Task PrevPage()
    {
        if (response?.HasPreviousPage == true)
        {
            pagina--;
            await CargarOrganizaciones();
        }
    }

    public class Organizacion
    {
        public int Id { get; set; }
        public string NombreOrganizacion { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Email { get; set; } = "";
        public string Notificacion { get; set; } = "";
        public int IdRol { get; set; }
        public string IdMunicipio { get; set; } = "";
    }

    public class Municipio
    {
        public string Id { get; set; } = "";
        public string Nombre { get; set; } = "";
    }

    public class PaginacionOrgResponse
    {
        public List<Organizacion> Items { get; set; } = new();
        public int TotalPages { get; set; }
        public int TotalCount { get; set; }
        public bool HasNextPage { get; set; }
        public bool HasPreviousPage { get; set; }
    }
}







