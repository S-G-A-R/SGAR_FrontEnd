@page "/index-horarios"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@inject HorarioService HorarioService
@inject NavigationManager Nav
@inject OrganizacionService OrganizacionService
@inject ZonaService ZonaService


<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet" />

<div class="horarios-container">
    <div class="header-section">
        <div class="header-bar">
            <h2 class="title-page">Gestión de Horarios</h2>

        </div>
        <div class="filtros-container">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <select @bind="selectedOrganizacion" @bind:after="AplicarFiltros" class="form-select">
                        <option value="0">Todas</option>
                        @foreach (var org in organizaciones)
                        {
                            <option value="@org.Id">@org.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <select @bind="selectedDia" @bind:after="AplicarFiltros" class="form-select">
                        <option value="">Todos los días</option>
                        @foreach (var d in diasSemana.Select((texto, index) => new { texto, index }))
                        {
                            <option value="@(d.index + 1)">@d.texto</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select @bind="selectedTurno" @bind:after="AplicarFiltros" class="form-select">
                        <option value="0">Todos los turnos</option>
                        <option value="1">Mañana</option>
                        <option value="2">Tarde</option>
                        <option value="3">Noche</option>
                        <option value="4">N/A</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select @bind="selectedPageSize" @bind:after="CambiarPageSize" class="form-select">
                        <option value="0">Mostrar todos</option>
                        <option value="5">5 por página</option>
                        <option value="10">10 por página</option>
                        <option value="25">25 por página</option>
                        <option value="50">50 por página</option>
                    </select>
                </div>
            </div>
            @if (TieneFiltrosActivos())
            {
                <div class="mt-2">
                    <button class="btn btn-limpiar" @onclick="LimpiarFiltros">
                        <i class="bi bi-eraser"></i>Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
    <p></p>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
     
        <button class="btn btn-crear" @onclick="CrearNuevo">
            <i class="bi bi-calendar-date"></i> Crear Horario
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando horarios...</span>
            </div>
            <p class="mt-2">Cargando horarios...</p>
        </div>
    }
    else if (horarios?.Count > 0)
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-hover custom-table">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Día</th>
                        <th>Organización</th>
                        <th>Zona</th>
                        <th>Turno</th>
                        <th>Horario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var horario in horarios)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@horario.Id</td>
                            <td><span class="badge badge-dia">@ObtenerDiaTexto(horario.Dia)</span></td>
                          @*   <td>@horario.IdOrganizacion</td>
                            <td><span class="badge badge-zona">@horario.ZonaId</span></td> *@
                            <td>@horario.OrganizacionNombre</td>
                            <td><span class="badge badge-zona">@horario.ZonaNombre</span></td>
                            <td>@ObtenerTurnoTexto(horario.Turno)</td>
                            <td>
                                <div class="d-flex align-items-center gap-1 justify-content-center">
                                    <span class="badge badge-hora badge-hora-inicio">@horario.HoraEntrada</span>
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="badge badge-hora badge-hora-fin">@horario.HoraSalida</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2 justify-content-center">
                                    <button class="btn-icon btn-view" @onclick="() => VerDetalle(horario.Id)" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn-icon btn-edit" @onclick="() => Editar(horario.Id)" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" @onclick="() => ConfirmarEliminar(horario)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (response != null && response.TotalPages > 0)
        {
            <div class="pagination-container mt-3 d-flex justify-content-between align-items-center">

                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(!response.HasPreviousPage)"
                        @onclick="PaginaAnterior">
                    ◀ Anterior
                </button>

                <span class="fw-bold page-info">
                    Página @response.CurrentPage de @response.TotalPages |
                    Total: @response.TotalCount horarios
                </span>

                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(!response.HasNextPage)"
                        @onclick="PaginaSiguiente">
                    Siguiente ▶
                </button>

            </div>
        }

    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-clock-history" style="font-size: 4rem; color: #ccc;"></i>
            <h4>No hay horarios registrados</h4>
            <p>@(TieneFiltrosActivos() ? "No se encontraron horarios con los filtros aplicados" : "Comienza creando tu primer horario")</p>
            <button class="btn btn-crear" @onclick="CrearNuevo">
                <i class="bi bi-calendar-date me-2"></i> Crear Horario
            </button>

        </div>
    }

    @*Nuevo estilo eliminar*@
   
    @if (mostrarModalEliminar)
    {
        <div class="card-modal-overlay" @onclick="CerrarModalEliminar">
            <div class="card-modal" @onclick:stopPropagation="true">

                <div class="card-modal-header">
                    <i class="bi bi-trash-fill text-danger"></i>
                    <h5>Eliminar Horario</h5>
                </div>

                <div class="card-modal-body">
                    <p class="fw-bold text-center mb-3">¿Está seguro de eliminar este horario?</p>

                    <div class="info-box">
                        <p><strong>ID:</strong> @horarioAEliminar?.Id</p>
                        <p><strong>Día:</strong> @ObtenerDiaTexto(horarioAEliminar!.Dia)</p>
                        <p><strong>Turno:</strong> @ObtenerTurnoTexto(horarioAEliminar!.Turno)</p>
                        <p><strong>Hora Entrada:</strong> @horarioAEliminar!.HoraEntrada</p>
                        <p><strong>Hora Salida:</strong> @horarioAEliminar!.HoraSalida</p>
                    </div>

                    <p class="text-danger text-center mt-2"><small>Esta acción no se puede deshacer.</small></p>
                </div>
                <div class="card-modal-actions mt-3">

                    <button class="btn-eliminar" @onclick="EliminarConfirmado">
                        <i class="bi bi-trash me-2"></i>Eliminar
                    </button>

                    <button class="btn-cancelar" @onclick="CerrarModalEliminar">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </button>

                </div>
            </div>
        </div>
    }


    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }
</div>

<style>
    .title-page {
        font-family: 'Lilita One', sans-serif;
        font-size: 32px;
        font-weight: normal; /* evita que se engrose demasiado */
        color: #050303; /* moradito suave, puedes cambiar */
        letter-spacing: 1px;
        text-align: center;
    }


    .horarios-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-bar {
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

  

    .table-responsive {
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-radius: 10px;
        margin-top: 10px;
    }

    .custom-table thead th {
        background: #212529;
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        border-bottom: 2px solid #dee2e6;
    }

    .custom-table tbody td {
        vertical-align: middle;
        font-size: 1rem;
    }

    .badge-dia {
        background: #e3f7fc;
        color: #212529;
        font-size: 1rem;
        border-radius: 6px;
        padding: 6px 12px;
        font-weight: 600;
    }

    .badge-zona {
        background: #6c757d;
        color: #fff;
        font-size: 1rem;
        border-radius: 6px;
        padding: 6px 12px;
    }

    .badge-hora {
        font-size: 1rem;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
    }

    .badge-hora-inicio {
        background: #198754;
        color: #fff;
    }

    .badge-hora-fin {
        background: #ffc107;
        color: #212529;
    }

    .btn-icon {
        border: none;
        background: transparent;
