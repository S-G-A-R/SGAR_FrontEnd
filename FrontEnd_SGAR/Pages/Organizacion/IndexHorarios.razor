@page "/index-horarios"
@using FrontEnd_SGAR.Services
@inject HorarioService HorarioService
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet" />

<div class="horarios-container">
    <div class="header-section">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-clock me-2"></i>Gestión de Horarios</h2>
            <button class="btn btn-success" @onclick="CrearNuevo">
                <i class="bi bi-plus-circle me-1"></i>Crear Horario
            </button>
        </div>

        <!-- Filtro Simple sin conflictos -->
        <div class="filtros-container">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <select @bind="selectedOrganizacion" @bind:after="AplicarFiltros" class="form-select">
                        <option value="0">Todas las organizaciones</option>
                        <option value="1">Organización 1</option>
                        <option value="2">Organización 2</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select @bind="selectedDia" @bind:after="AplicarFiltros" class="form-select">
                        <option value="">Todos los días</option>
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sábado">Sábado</option>
                        <option value="Domingo">Domingo</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select @bind="selectedTurno" @bind:after="AplicarFiltros" class="form-select">
                        <option value="0">Todos los turnos</option>
                        <option value="1">🌅 Mañana</option>
                        <option value="2">☀ Tarde</option>
                        <option value="3">🌙 Noche</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select @bind="selectedPageSize" @bind:after="CambiarPageSize" class="form-select">
                        <option value="5">5 por página</option>
                        <option value="10">10 por página</option>
                        <option value="25">25 por página</option>
                        <option value="50">50 por página</option>
                    </select>
                </div>
            </div>

            @if (TieneFiltrosActivos())
            {
                <div class="mt-3">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando horarios...</span>
            </div>
            <p class="mt-2">Cargando horarios...</p>
        </div>
    }
    else if (horarios?.Count > 0)
    {
        <!-- Tabla responsive -->
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-hover custom-table">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-hash me-1"></i>ID</th>
                        <th><i class="bi bi-calendar-day me-1"></i>Día</th>
                        <th><i class="bi bi-building me-1"></i>Org. ID</th>
                        <th><i class="bi bi-geo-alt me-1"></i>Zona</th>
                        <th><i class="bi bi-sun me-1"></i>Turno</th>
                        <th><i class="bi bi-clock me-1"></i>Horario</th>
                        <th><i class="bi bi-gear me-1"></i>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var horario in horarios)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@horario.Id</td>
                            <td>
                                <span class="badge bg-light text-dark">@horario.Dia</span>
                            </td>
                            <td>@horario.IdOrganizacion</td>
                            <td>
                                <span class="badge bg-secondary">@horario.ZonaId</span>
                            </td>
                            <td>@ObtenerTurnoTexto(horario.Turno)</td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-success">@horario.HoraEntrada</span>
                                    <i class="bi bi-arrow-right text-muted"></i>
                                    <span class="badge bg-warning text-dark">@horario.HoraSalida</span>
                                </div>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => VerDetalle(horario.Id)" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => Editar(horario.Id)" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(horario)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (response?.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(response.HasPreviousPage ? "" : "disabled")">
                        <button class="page-link" @onclick="PaginaAnterior">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </button>
                    </li>

                    @for (int i = Math.Max(1, response.CurrentPage - 2); i <= Math.Min(response.TotalPages, response.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == response.CurrentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => IrAPagina(i)">@i</button>
                        </li>
                    }

                    <li class="page-item @(response.HasNextPage ? "" : "disabled")">
                        <button class="page-link" @onclick="PaginaSiguiente">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>

            <div class="text-center mt-2">
                <small class="text-muted">
                    Página @response.CurrentPage de @response.TotalPages - Total: @response.TotalCount horarios
                </small>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-clock-history" style="font-size: 4rem; color: #ccc;"></i>
            <h4>No hay horarios registrados</h4>
            <p>@(TieneFiltrosActivos() ? "No se encontraron horarios con los filtros aplicados" : "Comienza creando tu primer horario")</p>
            <button class="btn btn-primary" @onclick="CrearNuevo">
                <i class="bi bi-plus-circle me-1"></i>Crear Horario
            </button>
        </div>
    }

    <!-- Modal Eliminar -->
    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay" @onclick="CerrarModalEliminar">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header-delete">
                    <h4><i class="bi bi-exclamation-triangle me-2"></i>Eliminar Horario</h4>
                </div>
                <div class="modal-body">
                    <p><strong>¿Está seguro de eliminar este horario?</strong></p>
                    <p>ID: <strong>@horarioAEliminar?.Id</strong></p>
                    <p>Día: <strong>@horarioAEliminar?.Dia</strong></p>
                    <p class="text-danger"><small>Esta acción no se puede deshacer.</small></p>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-danger" @onclick="EliminarConfirmado">
                        <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                    <button class="btn btn-secondary" @onclick="CerrarModalEliminar">
                        <i class="bi bi-x me-1"></i>Cancelar
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }
</div>

<style>
    .horarios-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .filtros-container {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 1px solid #e0e0e0;
    }

    .custom-table {
        background: white;
        margin-bottom: 0;
    }

        .custom-table thead th {
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.875rem;
        }

        .custom-table tbody tr:hover {
            background-color: #f8f9fa;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
    }

    .modal-content {
        background: white;
        border-radius: 15px;
        width: 100%;
        max-width: 500px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .modal-header-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .modal-body {
        padding: 20px;
        text-align: center;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        padding: 20px;
        justify-content: center;
        background: #f8f9fa;
    }
</style>

@code {
    private FiltroHorario filtros = new();
    private List<HorarioDTO> horarios = new();
    private PaginacionHorarioResponse? response;
    private bool cargando = true;

    // Variables separadas para evitar conflictos @bind/@onchange
    private int selectedOrganizacion = 0;
    private string selectedDia = "";
    private byte selectedTurno = 0;
    private int selectedPageSize = 10;

    // Modal eliminar
    private bool mostrarModalEliminar = false;
    private HorarioDTO? horarioAEliminar;

    // Mensajes
    private string mensajeError = "";
    private string mensajeExito = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarHorarios();
    }

    private async Task CargarHorarios()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            response = await HorarioService.ObtenerHorariosAsync(filtros);
            horarios = response?.Items ?? new List<HorarioDTO>();

            mensajeError = horarios.Count == 0 ? "No se encontraron horarios." : "";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
            Console.WriteLine($"💥 Error: {ex}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltros()
    {
        // Actualizar filtros desde las variables seleccionadas
        filtros.Organizacion = selectedOrganizacion;
        filtros.Dia = selectedDia;
        filtros.Turno = selectedTurno;
        filtros.Page = 1;
        await CargarHorarios();
    }

    private async Task LimpiarFiltros()
    {
        selectedOrganizacion = 0;
        selectedDia = "";
        selectedTurno = 0;

        filtros = new FiltroHorario { Size = filtros.Size };
        await CargarHorarios();
    }

    private bool TieneFiltrosActivos()
    {
        return selectedOrganizacion > 0 || !string.IsNullOrEmpty(selectedDia) || selectedTurno > 0;
    }

    private async Task CambiarPageSize()
    {
        filtros.Size = selectedPageSize;
        filtros.Page = 1;
        await CargarHorarios();
    }

    private async Task IrAPagina(int nuevaPagina)
    {
        filtros.Page = nuevaPagina;
        await CargarHorarios();
    }

    private async Task PaginaAnterior()
    {
        if (response?.HasPreviousPage == true)
        {
            filtros.Page--;
            await CargarHorarios();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (response?.HasNextPage == true)
        {
            filtros.Page++;
            await CargarHorarios();
        }
    }

    private void CrearNuevo() => Nav.NavigateTo("/horarios/crear");
    private void VerDetalle(int id) => Nav.NavigateTo($"/horarios/detalle/{id}");
    private void Editar(int id) => Nav.NavigateTo($"/horarios/editar/{id}");

    private void ConfirmarEliminar(HorarioDTO horario)
    {
        horarioAEliminar = horario;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        horarioAEliminar = null;
    }

    private async Task EliminarConfirmado()
    {
        if (horarioAEliminar == null) return;

        try
        {
            var success = await HorarioService.EliminarAsync(horarioAEliminar.Id);

            if (success)
            {
                mensajeExito = "Horario eliminado exitosamente";
                await CargarHorarios();
            }
            else
            {
                mensajeError = "Error al eliminar el horario";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            CerrarModalEliminar();

            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                mensajeError = "";
                mensajeExito = "";
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private string ObtenerTurnoTexto(byte turno) => turno switch
    {
        1 => "🌅 Mañana",
        2 => "☀ Tarde",
        3 => "🌙 Noche",
        _ => "❓ N/A"
    };
}