        background: #cfcfcf;
        border: 2px solid #b5b5b5;
        color: #333;
        padding: 10px 25px;
        border-radius: 12px;
        font-weight: 600;
        margin-left: 12px;
        transition: 0.2s ease-in-out;
    }

        .btn-cancelar:hover {
            background: #bfbfbf;
            border-color: #9e9e9e;
        }
</style>

@code {
    private FiltroHorario filtros = new();
    private List<HorarioDTO> horarios = new();
    private PaginacionHorarioResponse? response;
    private bool cargando = true;

    private List<OrganizacionDTO.Organizacion> organizaciones = new();
    // AGREGAR ESTA LÍNEA NUEVA ZONA
    private List<ZonaDTO.Zona> zonas = new();


    private int selectedOrganizacion = 0;
    private string selectedDia = "";
    private byte selectedTurno = 0;
    private int selectedPageSize = 10;

    private bool mostrarModalEliminar = false;
    private HorarioDTO? horarioAEliminar;

    private string mensajeError = "";
    private string mensajeExito = "";

    private readonly List<string> diasSemana = new()
    {
        "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
    };

    protected override async Task OnInitializedAsync()
    {
        organizaciones = await OrganizacionService.ObtenerOrganizacionesAsync();
            // AGREGAR ESTA LÍNEA NUEVA ZONA
        zonas = await ZonaService.ObtenerZonasAsync(); // <-- AGREGAR ESTO

        filtros.Size = selectedPageSize;
        await CargarHorarios();
    }

    private string ObtenerDiaTexto(string dia) => dia switch
    {
        "1" => "Lunes",
        "2" => "Martes",
        "3" => "Miércoles",
        "4" => "Jueves",
        "5" => "Viernes",
        "6" => "Sábado",
        "7" => "Domingo",
        _ => dia
    };

    private string ObtenerTurnoTexto(byte turno) => turno switch
    {
        1 => "Mañana",
        2 => "Tarde",
        3 => "Noche",
        _ => "N/A"
    };

    private async Task CargarHorarios()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            filtros.Organizacion = selectedOrganizacion;
            filtros.Dia = selectedDia;
            filtros.Turno = selectedTurno;
            filtros.Size = selectedPageSize;

            response = await HorarioService.ObtenerHorariosAsync(filtros);
            horarios = response?.Items ?? new List<HorarioDTO>();
            // AGREGAR ESTA LÍNEA NUEVA ZONA
            // Asignar nombre de la organización después de obtener la lista
            foreach (var h in horarios)
            {
                h.OrganizacionNombre = organizaciones
                    .FirstOrDefault(o => o.Id == h.IdOrganizacion)?.Nombre ?? "";
            }
            // AGREGAR ESTA LÍNEA NUEVA ZONA

            foreach (var h in horarios)
            {
                h.ZonaNombre = zonas
                    .FirstOrDefault(z => z.Id == h.ZonaId)?.Nombre ?? "";
            }


            mensajeError = horarios.Count == 0 ? "No se encontraron horarios." : "";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltros()
    {
        filtros.Page = 1;
        await CargarHorarios();
    }

    private async Task LimpiarFiltros()
    {
        selectedOrganizacion = 0;
        selectedDia = "";
        selectedTurno = 0;
        filtros = new FiltroHorario { Size = selectedPageSize, Page = 1 };
        await CargarHorarios();
    }

    private bool TieneFiltrosActivos()
    {
        return selectedOrganizacion > 0 || !string.IsNullOrEmpty(selectedDia) || selectedTurno > 0;
    }

    private async Task CambiarPageSize()
    {
        // filtros.Size = selectedPageSize;
        filtros.Page = 1;

        filtros.Size = selectedPageSize == 0 ? 9999 : selectedPageSize;

        await CargarHorarios();
    }

    private async Task IrAPagina(int nuevaPagina)
    {
        filtros.Page = nuevaPagina;
        await CargarHorarios();
    }

    private async Task PaginaAnterior()
    {
        if (response?.HasPreviousPage == true)
        {
            filtros.Page--;
            await CargarHorarios();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (response?.HasNextPage == true)
        {
            filtros.Page++;
            await CargarHorarios();
        }
    }

    private void CrearNuevo() => Nav.NavigateTo("/horarios/crear");
    private void VerDetalle(int id) => Nav.NavigateTo($"/horarios/detalle/{id}");
    private void Editar(int id) => Nav.NavigateTo($"/horarios/editar/{id}");

    private void ConfirmarEliminar(HorarioDTO horario)
    {
        horarioAEliminar = horario;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        horarioAEliminar = null;
    }

    private async Task EliminarConfirmado()
    {
        if (horarioAEliminar == null) return;

        try
        {
            var success = await HorarioService.EliminarAsync(horarioAEliminar.Id);

            if (success)
            {
                mensajeExito = "Horario eliminado exitosamente";
                await CargarHorarios();
            }
            else
            {
                mensajeError = "Error al eliminar el horario";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            CerrarModalEliminar();

            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                mensajeError = "";
                mensajeExito = "";
                InvokeAsync(StateHasChanged);
            });
        }
    }
}
