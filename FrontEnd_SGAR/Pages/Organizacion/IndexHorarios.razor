        align-items: center;
        justify-content: center;
    }

        .btn-icon:focus {
            outline: none;
            box-shadow: 0 0 0 2px #0d6efd33;
        }

    .btn-view {
        color: #0dcaf0;
    }

        .btn-view:hover {
            background: #e3f7fc;
        }

    .btn-edit {
        color: #ffc107;
    }

        .btn-edit:hover {
            background: #fffbe6;
        }

    .btn-delete {
        color: #dc3545;
    }

        .btn-delete:hover {
            background: #f8d7da;
        }

    /* --- MODAL CARD ESTILO MODERNO --- */

    .card-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
        z-index: 2000;
    }

    .card-modal {
