@page "/horarios/editar/{id:int}"
@using FrontEnd_SGAR.DTOs
@using FrontEnd_SGAR.Services
@inject HorarioService HorarioService
@inject NavigationManager Nav
@inject AuthOrganizacionService AuthService
@inject OrganizacionService OrganizacionService
@inject ZonaService ZonaService

<h2 class="text-center mb-4 fw-bold">
    <i class="bi bi-pencil-square me-2"></i>Editar Horario
</h2>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando datos...</p>
    </div>
}
else if (mensajeError != "")
{
    <div class="alert alert-danger shadow-sm">@mensajeError</div>
}
else
{
    <div class="card shadow-lg border-0">
        <div class="card-body p-4">

            <EditForm Model="nuevoHorario" OnValidSubmit="ActualizarHorario">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <h5 class="fw-semibold mb-3 text-primary">
                    <i class="bi bi-info-circle me-2"></i>Información del horario
                </h5>

                <div class="row g-4">

                    <!-- ORGANIZACION -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Organización</label>
                        <input class="form-control shadow-sm" value="@organizacionActual?.nombreOrganizacion" disabled />
                    </div>

                    <!-- ZONA -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Zona</label>
                        <select class="form-select shadow-sm" @bind="nuevoHorario.ZonaId" required>
                            <option value="">Seleccione una zona</option>
                            @foreach (var zona in zonas)
                            {
                                <option value="@zona.Id">@zona.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- DÍA -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Día</label>
                        <select class="form-select shadow-sm" @bind="nuevoHorario.Dia" required>
                            <option value="">Seleccione un día</option>
                            @foreach (var d in diasSemana.Select((texto, index) => new { texto, index }))
                            {
                                <option value="@(d.index + 1)"
                                        selected="@(nuevoHorario.Dia == (d.index + 1).ToString())">
                                    @d.texto
                                </option>
                            }
                        </select>
                    </div>

                    <!-- TURNO -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Turno</label>
                        <select class="form-select shadow-sm" @bind="nuevoHorario.Turno" required>
                            <option value="0">Seleccione turno</option>
                            <option value="1">Mañana</option>
                            <option value="2">Tarde</option>
                            <option value="3">Noche</option>
                        </select>
                    </div>

                    <!-- HORAS -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hora Entrada</label>
                        <input type="time" class="form-control shadow-sm" @bind-value="horaEntrada" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hora Salida</label>
                        <input type="time" class="form-control shadow-sm" @bind-value="horaSalida" required />
                    </div>

                </div>

                <!-- BOTONES -->
                <div class="mt-4 d-flex gap-3">

                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i>Actualizar
                    </button>

                    <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </button>

                </div>

                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success mt-3 shadow-sm">@mensajeExito</div>
                }

            </EditForm>

        </div>
    </div>
}


@code {
    [Parameter] public int id { get; set; }

    private HorarioGuardarDto nuevoHorario = new();
    private OrganizacionDTO.OrganizacionDetalle? organizacionActual;
    private List<ZonaDTO.Zona> zonas = new();
    private bool cargando = true;
    private string mensajeError = "";
    private string mensajeExito = "";

    private TimeOnly? horaEntrada;
    private TimeOnly? horaSalida;

    private readonly List<string> diasSemana = new()
    {
        "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
    };

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var jwt = await AuthService.ObtenerTokenDecodificado();
            var orgIdClaim = jwt?.Claims.FirstOrDefault(c => c.Type == "nameid")?.Value;
            var rolClaim = jwt?.Claims.FirstOrDefault(c => c.Type == "role")?.Value;

            int orgId = 0;
            int.TryParse(orgIdClaim, out orgId);

            if (rolClaim?.ToLower() != "organizacion" || orgId <= 0)
            {
                mensajeError = "No tienes permisos para editar horarios.";
                return;
            }

            organizacionActual = await OrganizacionService.ObtenerPorId(orgId);
            zonas = await ZonaService.ObtenerZonasAsync();

            var horarioExistente = await HorarioService.ObtenerPorIdAsync(id);
            if (horarioExistente == null)
            {
                mensajeError = "Horario no encontrado.";
                return;
            }

            // Mapear a DTO de edición
            nuevoHorario.IdOrganizacion = horarioExistente.IdOrganizacion;
            nuevoHorario.ZonaId = horarioExistente.ZonaId;
            nuevoHorario.Dia = horarioExistente.Dia;
            nuevoHorario.Turno = horarioExistente.Turno;

            horaEntrada = TimeOnly.Parse(horarioExistente.HoraEntrada);
            horaSalida = TimeOnly.Parse(horarioExistente.HoraSalida);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error cargando datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ActualizarHorario()
    {
        mensajeError = "";
        mensajeExito = "";

        if (horaEntrada == null || horaSalida == null)
        {
            mensajeError = "Debe ingresar ambas horas.";
            return;
        }
        if (horaEntrada >= horaSalida)
        {
            mensajeError = "La hora de entrada debe ser anterior a la hora de salida.";
            return;
        }

        nuevoHorario.HoraEntrada = horaEntrada.Value.ToString("HH:mm");
        nuevoHorario.HoraSalida = horaSalida.Value.ToString("HH:mm");

        var result = await HorarioService.ActualizarHorarioAsync(id, nuevoHorario);
        if (result != null)
        {
            mensajeExito = "Horario actualizado exitosamente.";
            await Task.Delay(1500);
            Nav.NavigateTo("/index-horarios");
        }
        else
        {
            mensajeError = "No se pudo actualizar el horario.";
        }
    }

    private void Cancelar() => Nav.NavigateTo("/index-horarios");
}
