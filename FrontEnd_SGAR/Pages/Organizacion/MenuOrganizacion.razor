@page "/MenuOrganizacion"
@inject NavigationManager Navigation

<div class="container text-center p-5">
    <div class="row align-items-center">

        <!-- Gestion Organizacion -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-25" href="/horarios">
                            <i class="bi bi-people-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Gestión Organización</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

        <!-- Gestión Vehículos -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-50" href="/mantenimiento">
                            <i class="bi bi-truck" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Gestión Vehículos</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

        <!-- Gestión Horarios -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-50" href="/ubicacion">
                            <i class="bi bi-calendar2-week-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Gestión Horarios</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

    </div>

    <div class="row align-items-center">

        <!-- Gestión Formularios -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-25">
                            <i class="bi bi-file-earmark-richtext-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Gestión Formularios</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

    </div>
</div>


@code {

    private void Error()
    {
        Navigation.NavigateTo("/sgarMantenimiento");
    }

}
