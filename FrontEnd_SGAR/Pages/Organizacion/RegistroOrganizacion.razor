@page "/registro-organizacion"
@using FrontEnd_SGAR.Services
@using System.ComponentModel.DataAnnotations
@using static FrontEnd_SGAR.DTOs.MunicipioDTO
@inject MunicipioService MunicipioService
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">
        <h3><i class="bi bi-building me-2"></i>Registrar Organización</h3>
        <hr />

        <EditForm Model="modelo" OnValidSubmit="Registrar">
            <DataAnnotationsValidator />
@*             <ValidationSummary />
 *@
            <div class="form-group">
                <label class="required">Nombre de organización</label>
                <InputText @bind-Value="modelo.NombreOrganizacion" class="form-control" placeholder="Ingresa el nombre" />
                <ValidationMessage For="@(() => modelo.NombreOrganizacion)" />
            </div>

            <div class="form-group">
                <label class="required">Teléfono</label>
                <InputText @bind-Value="modelo.Telefono" class="form-control" placeholder="8 dígitos (ej: 1234 5678)" />
                <ValidationMessage For="@(() => modelo.Telefono)" />
            </div>

            <div class="form-group">
                <label class="required">Correo electrónico</label>
                <InputText @bind-Value="modelo.Email" class="form-control" placeholder="ejemplo@correo.com" />
                <ValidationMessage For="@(() => modelo.Email)" />
            </div>

            <div class="form-group">
                <label class="required">Contraseña</label>
                <InputText @bind-Value="modelo.Password" type="password" class="form-control" placeholder="De 5 a 8 caracteres" />
                <ValidationMessage For="@(() => modelo.Password)" />
            </div>

            <div class="form-group">
                <label class="required">Municipio</label>
                <InputText list="listaMunicipios" @bind-Value="modelo.MunicipioSeleccionado" class="form-control" placeholder="Escribe o selecciona un municipio" />
                <datalist id="listaMunicipios">
                    @foreach (var municipio in municipios)
                    {
                        <option value="@municipio.Nombre"></option>
                    }
                </datalist>
                <ValidationMessage For="@(() => modelo.MunicipioSeleccionado)" />
            </div>

            <div class="form-group mt-3">
                <label>Tipos de notificación</label>
                <div class="form-check-group">
                    <label><InputCheckbox @bind-Value="notifProximidad" /> Notificación por proximidad</label><br />
                    <label><InputCheckbox @bind-Value="notifInicioRuta" /> Notificación al iniciar ruta</label><br />
                    <label><InputCheckbox @bind-Value="notifTiempoReal" /> Seguimiento en tiempo real</label>
                </div>
            </div>

            <div class="botones mt-4">
                <div class="contenedor-boton">
                    <button type="submit" class="boton-mapacheAceptar">Registrar</button>
                    <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                    <img src="css/orejaDe.png" class="oreja oreja-derecha" />
                </div>
                <button type="button" class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
            </div>
        </EditForm>

        <!-- ✅ Notificación tipo campana -->
        <div id="successAlert" class="success-alert hidden">
            <div class="alert-box">
                <div class="alert-icon">🔔</div>
                <div class="alert-text" id="alertMessage">Mensaje por defecto</div>
            </div>
        </div>

    </div>
</div>

<style>
    .success-alert {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        transition: all 0.4s ease;
        opacity: 0;
        transform: translateY(-20px);
    }

        .success-alert.show {
            opacity: 1;
            transform: translateY(0);
        }

        .success-alert.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .alert-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .alert-icon {
        font-size: 1.8rem;
        color: #ffcc00;
        animation: ring 0.6s ease-in-out;
    }

    .alert-text {
        font-weight: 500;
        color: #333;
    }
</style>

<script>
    function showCustomAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "🔔";
        alert.querySelector(".alert-icon").style.color = "#ffcc00";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }

    function showErrorAlert(message) {
        const alert = document.getElementById("successAlert");
        const text = document.getElementById("alertMessage");

        alert.querySelector(".alert-icon").textContent = "❌";
        alert.querySelector(".alert-icon").style.color = "#e63946";

        text.textContent = message;
        alert.classList.remove("hidden");
        alert.classList.add("show");

        setTimeout(() => {
            alert.classList.remove("show");
            alert.classList.add("hidden");
        }, 3000);
    }
</script>


@code {
    // ✅ Modelo de validación
    public class RegistroOrganizacionModel
    {
        [Required(ErrorMessage = "El nombre de la organización es obligatorio.")]
        [RegularExpression(@"^[^\d\-]+$", ErrorMessage = "El nombre no puede contener números ni signos negativos.")]
        public string NombreOrganizacion { get; set; } = "";

        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(@"^\d{4}\s?\d{4}$", ErrorMessage = "El teléfono debe tener 8 dígitos (puede incluir un espacio).")]
        public string Telefono { get; set; } = "";

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "El correo no tiene un formato válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [StringLength(8, MinimumLength = 5, ErrorMessage = "La contraseña debe tener entre 5 y 8 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Debe seleccionar un municipio.")]
        [RegularExpression(@"^[^\d\-]+$", ErrorMessage = "El municipio no puede contener números ni signos negativos.")]
        public string MunicipioSeleccionado { get; set; } = "";
    }

    // Instancia del modelo
    private RegistroOrganizacionModel modelo = new();

    private bool notifProximidad;
    private bool notifInicioRuta;
    private bool notifTiempoReal;

    private List<Municipio> municipios = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            municipios = await MunicipioService.ObtenerMunicipiosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar municipios: {ex.Message}");
            municipios = new List<Municipio>();
        }
    }

    // VALIDACIÓN MANUAL PERSONALIZADA
    private bool ValidarCampos()
    {
        // Nombre obligatorio
        if (string.IsNullOrWhiteSpace(modelo.NombreOrganizacion))
        {
            JS.InvokeVoidAsync("showErrorAlert", "Debe ingresar un nombre de organización");
            return false;
        }

        // Teléfono válido 8 dígitos con o sin espacio
        if (!System.Text.RegularExpressions.Regex.IsMatch(modelo.Telefono, @"^\d{4}\s?\d{4}$"))
        {
            JS.InvokeVoidAsync("showErrorAlert", "El teléfono debe tener 8 dígitos (puede incluir un espacio)");
            return false;
        }

        // Correo válido
        if (!System.Text.RegularExpressions.Regex.IsMatch(modelo.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            JS.InvokeVoidAsync("showErrorAlert", "Ingrese un correo válido");
            return false;
        }

        // Contraseña 5–8 caracteres
        if (modelo.Password.Length < 5 || modelo.Password.Length > 8)
        {
            JS.InvokeVoidAsync("showErrorAlert", "La contraseña debe tener entre 5 y 8 caracteres");
            return false;
        }

        // Municipio seleccionado
        if (string.IsNullOrWhiteSpace(modelo.MunicipioSeleccionado))
        {
            JS.InvokeVoidAsync("showErrorAlert", "Debe seleccionar un municipio");
            return false;
        }

        return true;
    }


    private async Task Registrar()
    {
        //VALIDAR CAMPOS ANTES DE ENVIAR
        if (!ValidarCampos())
            return;

        try
        {
        string tiposNotificacion = $"{(notifProximidad ? "1" : "0")}{(notifInicioRuta ? "1" : "0")}{(notifTiempoReal ? "1" : "0")}";

        var municipio = municipios.FirstOrDefault(m =>
            m.Nombre.Equals(modelo.MunicipioSeleccionado, StringComparison.OrdinalIgnoreCase));

        string idMunicipio = municipio?.Id ?? string.Empty;

        var data = new
        {
            idMunicipio,
            nombreOrganizacion = modelo.NombreOrganizacion,
            telefono = modelo.Telefono,
            email = modelo.Email,
            password = modelo.Password,
            idRol = 5,
            notificacion = tiposNotificacion
        };

        var response = await Http.PostAsJsonAsync("api/organization", data);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ResponseMessage>();
            // ALERTA DE ÉXITO
            await JS.InvokeVoidAsync("showCustomAlert", $"Organización registrada: {result?.Message}");

            await Task.Delay(1800);
            Nav.NavigateTo("/login-organizacion");
        }
            else
            {
                // ERROR CONTROLADO DEL BACKEND
                await JS.InvokeVoidAsync("showErrorAlert", "No se pudo registrar la organización");
            }
        }
        catch (Exception)
        {
            // ERROR DEL SISTEMA (SERVIDOR CAÍDO)
            await JS.InvokeVoidAsync("showErrorAlert", "Error del sistema. Intente de nuevo.");
        }
    }

    private void Cancelar()
    {
        modelo = new();
        notifProximidad = notifInicioRuta = notifTiempoReal = false;
        Nav.NavigateTo("/login-organizacion");
    }

    public class ResponseMessage
    {
        public string Message { get; set; } = "";
        public int Id { get; set; }
    }
}







