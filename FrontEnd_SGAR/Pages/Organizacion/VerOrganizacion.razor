@page "/organizacion-ver/{Id:int}"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.MunicipioDTO
@using static FrontEnd_SGAR.DTOs.OrganizacionDTO
@using Microsoft.AspNetCore.Components.Forms
@inject OrganizacionService OrganizacionService
@inject MunicipioService MunicipioService 
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">
        <h3><i class="bi bi-building me-2"></i>Detalle de Organización</h3>
        <hr />

        @if (organizacionDetalle == null || !municipioCargado) // Verificar si ambos están cargados
        {
                <p><em>Cargando o no se encontró la organización con ID: @Id...</em></p>
        }
        else
        {
                <div class="form-group">
                    <label>ID: </label>
                    @organizacionDetalle.Id
                </div>

                <div class="form-group">
                    <label>Nombre de organización: </label>
                   @organizacionDetalle.nombreOrganizacion
                </div>

                <div class="form-group">
                    <label>Teléfono: </label>
                   @organizacionDetalle.telefono
                </div>

                <div class="form-group">
                    <label>Correo electrónico: </label>
                   @organizacionDetalle.email
                </div>

                <div class="form-group">
                    <label>Municipio: </label>
                  @nombreMunicipioDisplay
                </div>

                <div class="form-group">
                    <label>Rol: </label>
                   @nombreRolDisplay
                </div>

                <div class="form-group mt-3">
                    <label>Tipos de notificación: </label>
                    <div class="form-check-group">
                        <label>
                            <InputCheckbox @bind-Value="notifProximidad" disabled /> Notificación por proximidad
                        </label><br />
                        <label>
                            <InputCheckbox @bind-Value="notifInicioRuta" disabled /> Notificación al iniciar ruta
                        </label><br />
                        <label>
                            <InputCheckbox @bind-Value="notifTiempoReal" disabled /> Seguimiento en tiempo real
                        </label>
                    </div>
                </div>

                <div class="botones mt-4 d-flex gap-2 justify-content-center">
                        <button type="button" class="btn-limpiar" style="width: 150px;" @onclick="Volver">
                        <i class="bi bi-arrow-left-circle me-1"></i> Volver
                    </button>
                </div>
        }
    </div>
</div>

<style>
    /* Mantiene el texto de la opción de notificación más oscuro */
    .form-check-group label {
        font-weight: normal;
        color: #333;
        opacity: 1;
    }

    /* Hace que el InputCheckbox deshabilitado se vea más fuerte (si el navegador lo permite) */
    .form-check-group input[type="checkbox"]:disabled {
        opacity: 1;
        filter: none; 
        cursor: default;
    }

/* BOTÓN */
.btn-limpiar {
    border: 2px solid #000;
    background: #fff;
    color: #520B0B;
    width: 50%;
    font-size: 14px;
    border-radius: 6px;
    padding: 7px;
    transition: .2s;
    font-weight: bold; /* ← Aquí se hace negrita */
}

    .btn-limpiar:hover {
        background: #AD3440;
        color: black;
        transform: scale(1.05);
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private OrganizacionDetalle? organizacionDetalle;
    private bool notifProximidad;
    private bool notifInicioRuta;
    private bool notifTiempoReal;

    // Variables para el nombre descriptivo
    private string nombreMunicipioDisplay = "Cargando...";
    private string nombreRolDisplay = "Cargando...";
    private bool municipioCargado = false;


    protected override async Task OnInitializedAsync()
    {
        // Cargar ambas tareas en paralelo o secuencialmente
        await LoadOrganizacionDetalle(Id);
        await LoadMunicipioNombre();

        // El Rol 5 siempre es Organización
        if (organizacionDetalle != null && organizacionDetalle.idRol == 5)
        {
            nombreRolDisplay = "Organización";
        }
        else
        {
            nombreRolDisplay = "Rol Desconocido (" + (organizacionDetalle?.idRol.ToString() ?? "N/A") + ")";
        }

        municipioCargado = true;
    }

    // --- LÓGICA DE CARGA DE ORGANIZACIÓN ---
    private async Task LoadOrganizacionDetalle(int id)
    {
        try
        {
            organizacionDetalle = await OrganizacionService.ObtenerPorId(id);

            if (organizacionDetalle != null && !string.IsNullOrEmpty(organizacionDetalle.notificacion))
            {
                string notif = organizacionDetalle.notificacion;
                notifProximidad = notif.Length > 0 && notif[0] == '1';
                notifInicioRuta = notif.Length > 1 && notif[1] == '1';
                notifTiempoReal = notif.Length > 2 && notif[2] == '1';
            }
            else if (organizacionDetalle == null)
            {
                await JS.InvokeVoidAsync("showErrorAlert", $"No se encontró la organización con ID {id}.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error al cargar la organización: {ex.Message}");
            organizacionDetalle = null;
        }
    }

    // --- LÓGICA DE CARGA DE NOMBRE DEL MUNICIPIO ---
    private async Task LoadMunicipioNombre()
    {
        if (organizacionDetalle == null || string.IsNullOrEmpty(organizacionDetalle.idMunicipio))
        {
            nombreMunicipioDisplay = "ID de Municipio No Disponible";
            return;
        }

        try
        {
            // 1. Obtener la lista completa de municipios
            var municipios = await MunicipioService.ObtenerMunicipiosAsync();

            // 2. Buscar el nombre del municipio por el ID que tenemos
            var municipioEncontrado = municipios.FirstOrDefault(m =>
                m.Id.Equals(organizacionDetalle.idMunicipio, StringComparison.OrdinalIgnoreCase));

            if (municipioEncontrado != null)
            {
                nombreMunicipioDisplay = $"{municipioEncontrado.Nombre} ({municipioEncontrado.IdDepartamento?.Nombre})";
            }
            else
            {
                nombreMunicipioDisplay = "Municipio No Encontrado (ID: " + organizacionDetalle.idMunicipio + ")";
            }
        }
        catch (Exception)
        {
            nombreMunicipioDisplay = "Error al cargar municipios";
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/index-organizacion");
    }
}
















