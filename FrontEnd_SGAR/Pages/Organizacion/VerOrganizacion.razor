@page "/organizacion-ver/{Id:int}"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.MunicipioDTO
@using static FrontEnd_SGAR.DTOs.OrganizacionDTO
@using Microsoft.AspNetCore.Components.Forms
@inject OrganizacionService OrganizacionService
@inject MunicipioService MunicipioService
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">
        <!-- Título -->
        <h3><i class="bi bi-building me-2"></i>Detalle de Organización</h3>
        <hr />

        @if (organizacionDetalle == null || !municipioCargado)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Cargando datos...</p>
            </div>
        }
        else
        {
            <div class="row g-4 mt-2">

                <!-- ID -->
                <div class="col-md-6">
                    <label>ID</label>
                    <div class="dato-box">@organizacionDetalle.Id</div>
                </div>

                <!-- Nombre -->
                <div class="col-md-6">
                    <label>Nombre de organización</label>
                    <div class="dato-box">@organizacionDetalle.nombreOrganizacion</div>
                </div>

                <!-- Teléfono -->
                <div class="col-md-6">
                    <label>Teléfono</label>
                    <div class="dato-box">@organizacionDetalle.telefono</div>
                </div>

                <!-- Correo -->
                <div class="col-md-6">
                    <label>Correo electrónico</label>
                    <div class="dato-box">@organizacionDetalle.email</div>
                </div>

                <!-- Municipio -->
                <div class="col-md-6">
                    <label>Municipio</label>
                    <div class="dato-box">@nombreMunicipioDisplay</div>
                </div>

                <!-- Rol -->
                <div class="col-md-6">
                    <label>Rol</label>
                    <div class="dato-box">@nombreRolDisplay</div>
                </div>

                <!-- Notificaciones -->
                <div class="col-12">
                    <label>Tipos de notificación</label>
                    <div class="dato-box flex-column">
                        <label><InputCheckbox @bind-Value="notifProximidad" disabled /> Notificación por proximidad</label>
                        <label><InputCheckbox @bind-Value="notifInicioRuta" disabled /> Notificación al iniciar ruta</label>
                        <label><InputCheckbox @bind-Value="notifTiempoReal" disabled /> Seguimiento en tiempo real</label>
                    </div>
                </div>

            </div>

            <div class="text-center mt-4 mb-2">
                <button class="btn-cancelar" @onclick="Volver">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
            </div>
        }
    </div>
</div>

<style>
    /* Igual que "Detalle de Horario" */
    .dato-box {
        background: #d9d9d9 !important;
        border: 2px solid #b5b5b5 !important;
        border-radius: 10px;
        padding: 12px 15px;
        width: 100%;
        font-size: 16px;
        display: flex;
        align-items: center;
    }

        .dato-box.flex-column {
            flex-direction: column;
            gap: 5px;
            align-items: flex-start;
        }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        height: 48px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.2s;
    }

        .btn-cancelar:hover {
            background-color: #5a6268;
        }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private OrganizacionDetalle? organizacionDetalle;
    private bool notifProximidad;
    private bool notifInicioRuta;
    private bool notifTiempoReal;

    private string nombreMunicipioDisplay = "Cargando...";
    private string nombreRolDisplay = "Cargando...";
    private bool municipioCargado = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizacionDetalle(Id);
        await LoadMunicipioNombre();

        if (organizacionDetalle != null && organizacionDetalle.idRol == 5)
            nombreRolDisplay = "Organización";
        else
            nombreRolDisplay = "Rol Desconocido (" + (organizacionDetalle?.idRol.ToString() ?? "N/A") + ")";

        municipioCargado = true;
    }

    private async Task LoadOrganizacionDetalle(int id)
    {
        try
        {
            organizacionDetalle = await OrganizacionService.ObtenerPorId(id);

            if (organizacionDetalle != null && !string.IsNullOrEmpty(organizacionDetalle.notificacion))
            {
                string notif = organizacionDetalle.notificacion;
                notifProximidad = notif.Length > 0 && notif[0] == '1';
                notifInicioRuta = notif.Length > 1 && notif[1] == '1';
                notifTiempoReal = notif.Length > 2 && notif[2] == '1';
            }
            else if (organizacionDetalle == null)
            {
                await JS.InvokeVoidAsync("showErrorAlert", $"No se encontró la organización con ID {id}.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", $"Error al cargar la organización: {ex.Message}");
            organizacionDetalle = null;
        }
    }

    private async Task LoadMunicipioNombre()
    {
        if (organizacionDetalle == null || string.IsNullOrEmpty(organizacionDetalle.idMunicipio))
        {
            nombreMunicipioDisplay = "ID de Municipio No Disponible";
            return;
        }

        try
        {
            var municipios = await MunicipioService.ObtenerMunicipiosAsync();
            var municipioEncontrado = municipios.FirstOrDefault(m => m.Id.Equals(organizacionDetalle.idMunicipio, StringComparison.OrdinalIgnoreCase));
            nombreMunicipioDisplay = municipioEncontrado != null
                ? $"{municipioEncontrado.Nombre} ({municipioEncontrado.IdDepartamento?.Nombre})"
                : "Municipio No Encontrado (ID: " + organizacionDetalle.idMunicipio + ")";
        }
        catch
        {
            nombreMunicipioDisplay = "Error al cargar municipios";
        }
    }

    private void Volver() => Nav.NavigateTo("/index-organizacion");
}


