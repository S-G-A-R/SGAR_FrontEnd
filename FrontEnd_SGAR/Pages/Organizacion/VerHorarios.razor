@page "/horarios/detalle/{id:int}"
@using FrontEnd_SGAR.DTOs
@using FrontEnd_SGAR.Services
@inject HorarioService HorarioService
@inject NavigationManager Nav

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary m-0">
            <i class="bi bi-clock-history me-2"></i>Detalle del Horario
        </h2>

        <button class="btn btn-outline-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando datos...</p>
        </div>
    }
    else if (horario == null)
    {
        <div class="alert alert-danger text-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            No se encontró el horario.
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4 p-4">

            <div class="row g-4">

                <div class="col-md-4">
                    <label class="fw-semibold text-secondary">Organización</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-building me-2"></i>@horario.OrganizacionNombre
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="fw-semibold text-secondary">Zona</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-geo-alt me-2"></i>@horario.ZonaNombre
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="fw-semibold text-secondary">Día</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-calendar-day me-2"></i>@ObtenerDiaTexto(horario.Dia)
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="fw-semibold text-secondary">Turno</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-brightness-high me-2"></i>@ObtenerTurnoTexto(horario.Turno)
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="fw-semibold text-secondary">Hora Entrada</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-door-open me-2"></i>@horario.HoraEntrada
                    </div>

                </div>

                <div class="col-md-4">
                 
                    <label class="fw-semibold text-secondary">Hora Salida</label>
                    <div class="form-control-plaintext border rounded p-2 bg-light">
                        <i class="bi bi-door-closed me-2"></i>@horario.HoraSalida
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private HorarioDTO? horario;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            horario = await HorarioService.ObtenerPorIdAsync(id);
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerTurnoTexto(byte turno) => turno switch
    {
        1 => "Mañana",
        2 => "Tarde",
        3 => "Noche",
        _ => "N/A"
    };

    private string ObtenerDiaTexto(string dia) => dia switch
    {
        "1" => "Lunes",
        "2" => "Martes",
        "3" => "Miércoles",
        "4" => "Jueves",
        "5" => "Viernes",
        "6" => "Sábado",
        "7" => "Domingo",
        _ => dia
    };

    private void Volver() => Nav.NavigateTo("/index-horarios");
}


