@* CARGA OPERADORES *@
@page "/operador-horarios"
@using System.Net.Http.Json
@using FrontEnd_SGAR.DTOs
@inject HttpClient _http

<h3>Asignaciones de Horarios a Operadores</h3>

<button class="btn btn-primary mb-3" @onclick="MostrarCrearModal">Crear Asignación</button>

@if (Cargando)
{
    <p>Cargando asignaciones...</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Operador</th>
                <th>Horarios Asignados</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Asignaciones)
            {
                <tr>
                    <td>@a.CodigoOperador</td>

                    <td>
                        @if (a.Horarios != null)
                        {
                            @foreach (var h in a.Horarios)
                            {
                                <span class="badge bg-info text-dark me-1">
                                    @h.HoraEntrada - @h.HoraSalida (@h.Dia)
                                </span>
                            }
                        }
                    </td>

                    <td>
                        <button class="btn btn-sm btn-warning me-2" @onclick="() => MostrarEditarModal(a)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(a.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (MostrarModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content p-3">

                <h5>@(EsEditar ? "Editar Asignación" : "Crear Asignación")</h5>

                <!-- OPERADOR -->
                <div class="mb-3">
                    <label>Operador:</label>
                    <select class="form-select" @bind="AsignacionSeleccionada.OperadorId">
                        <option value="0">-- Seleccione operador --</option>

                        @foreach (var o in Operadores)
                        {
                            <option value="@o.Id">@o.CodigoOperador</option>
                        }
                    </select>
                </div>

                <!-- HORARIOS -->
                <div class="mb-3">
                    <label>Horarios:</label>

                    <select multiple class="form-select" @onchange="OnSeleccionHorariosChanged">
                        @foreach (var h in Horarios)
                        {
                            <option value="@h.Id"
                                    selected="@SeleccionHorariosIds.Contains(h.Id)">
                                @h.HoraEntrada - @h.HoraSalida (@h.Dia)
                            </option>
                        }
                    </select>
                </div>

                <button class="btn btn-success me-2" @onclick="Guardar">Guardar</button>
                <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {

    // RESPUESTA DEL LISTADO DE OPERADORES
    public class OperadorListaResponse
    {
        public List<OperadorDTO> Items { get; set; } = new();
    }

    // -------------------------------
    // VARIABLES
    // -------------------------------
    List<OperadorHorarioDTO> Asignaciones = new();
    List<OperadorDTO> Operadores = new();
    List<HorarioDTO> Horarios = new();

    bool Cargando = true;
    bool MostrarModal = false;
    bool EsEditar = false;

    OperadorHorarioDTO AsignacionSeleccionada = new();
    List<int> SeleccionHorariosIds = new();

    public class PagedResponse<T>
    {
        public List<T> Content { get; set; } = new();
        public int TotalElements { get; set; }
        public int TotalPages { get; set; }
    }

    public class PaginacionHorarioResponse
    {
        public List<HorarioDTO> Content { get; set; } = new();
        public int TotalElements { get; set; }
        public int TotalPages { get; set; }
    }

    // -------------------------------
    // INICIALIZACION
    // -------------------------------
    protected override async Task OnInitializedAsync()
    {
        await CargarOperadores();
        await CargarHorarios();
        await CargarAsignaciones();

        Cargando = false;
    }

    async Task CargarOperadores()
    {
        var resp = await _http.GetFromJsonAsync<OperadorListaResponse>("ApiSeguridad/api/operador/list");
        Operadores = resp?.Items ?? new();
    }

    async Task CargarHorarios()
    {
        var resp = await _http.GetFromJsonAsync<PaginacionHorarioResponse>(
            "ApiAdmi/api/horarios?page=0&size=100"
        );

        Horarios = resp?.Content ?? new();
    }

    async Task CargarAsignaciones()
    {
        var resp = await _http.GetFromJsonAsync<PagedResponse<OperadorHorarioDTO>>(
            "ApiAdmi/api/operador-horarios?page=0&size=100"
        );

        Asignaciones = resp?.Content ?? new();
    }

    // -------------------------------
    // MODAL
    // -------------------------------
    void MostrarCrearModal()
    {
        EsEditar = false;
        AsignacionSeleccionada = new();
        SeleccionHorariosIds = new();
        MostrarModal = true;
    }

    void MostrarEditarModal(OperadorHorarioDTO asign)
    {
        EsEditar = true;
        AsignacionSeleccionada = asign;
        SeleccionHorariosIds = asign.Horarios.Select(h => h.Id).ToList();
        MostrarModal = true;
    }

    void CerrarModal()
    {
        MostrarModal = false;
    }

    // -------------------------------
    // GUARDAR
    // -------------------------------
    async Task Guardar()
    {
        if (AsignacionSeleccionada.OperadorId == 0 || !SeleccionHorariosIds.Any())
            return;

        var dto = new
        {
            operadorId = AsignacionSeleccionada.OperadorId,
            horariosIds = SeleccionHorariosIds
        };

        if (EsEditar)
        {
            await _http.PutAsJsonAsync($"ApiAdmi/api/operador-horarios/{AsignacionSeleccionada.Id}", dto);
        }
        else
        {
            await _http.PostAsJsonAsync($"ApiAdmi/api/operador-horarios", dto);
        }

        await CargarAsignaciones();
        CerrarModal();
    }

    // -------------------------------
    // ELIMINAR
    // -------------------------------
    async Task Eliminar(int id)
    {
        await _http.DeleteAsync($"ApiAdmi/api/operador-horarios/{id}");
        await CargarAsignaciones();
    }

    // -------------------------------
    // MANEJO DE SELECT DE HORARIOS
    // -------------------------------
    void OnSeleccionHorariosChanged(ChangeEventArgs e)
    {
        if (e.Value is string valores)
        {
            SeleccionHorariosIds = valores
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(int.Parse)
                .ToList();
        }
    }

}



