@page "/organizacion-eliminar/{Id:int}"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using static FrontEnd_SGAR.DTOs.MunicipioDTO
@using static FrontEnd_SGAR.DTOs.OrganizacionDTO
@using Microsoft.AspNetCore.Components.Forms
@inject OrganizacionService OrganizacionService
@inject MunicipioService MunicipioService
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container d-flex justify-content-center mt-5">
    <div class="card-modal">

        <div class="card-modal-header">
            <i class="bi bi-trash-fill text-danger"></i>
            <h5>Eliminar Organización</h5>
        </div>

        <div class="card-modal-body">
            <p class="fw-bold text-center mb-3">
                ¿Está seguro que desea eliminar esta organización? Esta acción no se puede deshacer.
            </p>

            @if (organizacionDetalle == null || !municipioCargado)
            {
                <p><em>Cargando organización con ID: @Id...</em></p>
            }
            else
            {
                <div class="info-box">
                    <p><strong>ID:</strong> @organizacionDetalle.Id</p>
                    <p><strong>Nombre:</strong> @organizacionDetalle.nombreOrganizacion</p>
                    <p><strong>Correo:</strong> @organizacionDetalle.email</p>
                    <p><strong>Municipio:</strong> @nombreMunicipioDisplay</p>
                    <p><strong>Rol:</strong> @nombreRolDisplay</p>

                    <p class="mt-2 mb-1 fw-bold">Notificaciones Activas:</p>
                    <p>
                        <i class="@(notifProximidad ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-2"></i>
                        Notificación por proximidad
                    </p>
                    <p>
                        <i class="@(notifInicioRuta ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-2"></i>
                        Notificación al iniciar ruta
                    </p>
                    <p>
                        <i class="@(notifTiempoReal ? "bi bi-check-circle-fill text-success" : "bi bi-x-circle-fill text-danger") me-2"></i>
                        Seguimiento en tiempo real
                    </p>
                </div>
            }
        </div>

        <div class="card-modal-actions">
            <button class="btn-eliminar" @onclick="ConfirmarEliminar">
                <i class="bi bi-trash me-2"></i>Eliminar
            </button>

            <button class="btn-cancelar" @onclick="Volver">
                <i class="bi bi-x-lg me-2"></i>Cancelar
            </button>
        </div>

    </div>
</div>

<style>
    /* Tarjeta estilo formulario moderno */
    .card-modal {
        background: #fff;
        width: 450px;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        /* Eliminamos animación de modal si quieres que sea estático */
    }

    .card-modal-header {
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
    }

        .card-modal-header h5 {
            margin: 0;
            font-weight: 700;
        }

    .card-modal-body {
        margin-top: 15px;
    }

    .info-box {
        background: #f8f9fa;
        padding: 12px 15px;
        border-radius: 10px;
        border-left: 4px solid #dc3545;
    }

    .card-modal-actions {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    /* Botón Eliminar */
    .btn-eliminar {
        background: #d9534f;
        border: 2px solid #b94440;
        color: white;
        padding: 10px 25px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s ease-in-out;
    }

        .btn-eliminar:hover {
            background: #c64541;
            border-color: #a93734;
        }

    /* Botón Cancelar */
    .btn-cancelar {
        background: #cfcfcf;
        border: 2px solid #b5b5b5;
        color: #333;
        padding: 10px 25px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s ease-in-out;
    }

        .btn-cancelar:hover {
            background: #bfbfbf;
            border-color: #9e9e9e;
        }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private OrganizacionDetalle? organizacionDetalle;
    private bool notifProximidad;
    private bool notifInicioRuta;
    private bool notifTiempoReal;
    private string nombreMunicipioDisplay = "Cargando...";
    private string nombreRolDisplay = "Cargando...";
    private bool municipioCargado = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizacionDetalle(Id);
        await LoadMunicipioNombre();

        if (organizacionDetalle != null && organizacionDetalle.idRol == 5)
            nombreRolDisplay = "Organización";
        else
            nombreRolDisplay = "Rol Desconocido (" + (organizacionDetalle?.idRol.ToString() ?? "N/A") + ")";

        municipioCargado = true;
    }

    private async Task ConfirmarEliminar()
    {
        if (organizacionDetalle == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("ConfirmarSweetAlert", new
        {
            title = "¿Estás seguro?",
            html = $"¡Vas a eliminar permanentemente la organización <strong>{organizacionDetalle.nombreOrganizacion}</strong> (ID: {Id})!",
            icon = "warning",
            showCancelButton = true,
            confirmButtonText = "Sí, eliminar",
            cancelButtonText = "Cancelar",
            reverseButtons = true,
            confirmButtonColor = "#DC3545",
            cancelButtonColor = "#3f51b5"
        });

        if (confirmed)
        {
            try
            {
                bool exito = await OrganizacionService.Eliminar(Id);
                if (exito)
                {
                    await JS.InvokeVoidAsync("MostrarAlerta", new
                    {
                        title = "¡Eliminación Exitosa!",
                        html = $"La organización con ID <strong>{Id}</strong> ha sido eliminada.",
                        icon = "success",
                        showConfirmButton = false,
                        timer = 2000
                    });
                    await Task.Delay(500);
                    Nav.NavigateTo("/index-organizacion");
                }
            }
            catch (Exception ex) { await JS.InvokeVoidAsync("MostrarAlerta", new { title = "Error", html = $"Error: {ex.Message}", icon = "error" }); }
        }
    }

    private async Task LoadOrganizacionDetalle(int id)
    {
        try
        {
            organizacionDetalle = await OrganizacionService.ObtenerPorId(id);
            if (organizacionDetalle != null && !string.IsNullOrEmpty(organizacionDetalle.notificacion))
            {
                string notif = organizacionDetalle.notificacion;
                notifProximidad = notif.Length > 0 && notif[0] == '1';
                notifInicioRuta = notif.Length > 1 && notif[1] == '1';
                notifTiempoReal = notif.Length > 2 && notif[2] == '1';
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("MostrarAlerta", new { title = "Error de Carga", html = $"Error: {ex.Message}", icon = "error" }); organizacionDetalle = null; }
    }

    private async Task LoadMunicipioNombre()
    {
        if (organizacionDetalle == null || string.IsNullOrEmpty(organizacionDetalle.idMunicipio))
        {
            nombreMunicipioDisplay = "ID de Municipio No Disponible";
            return;
        }
        try
        {
            var municipios = await MunicipioService.ObtenerMunicipiosAsync();
            var municipioEncontrado = municipios.FirstOrDefault(m => m.Id.Equals(organizacionDetalle.idMunicipio, StringComparison.OrdinalIgnoreCase));
            nombreMunicipioDisplay = municipioEncontrado != null
                ? $"{municipioEncontrado.Nombre} ({municipioEncontrado.IdDepartamento?.Nombre})"
                : "Municipio No Encontrado (ID: " + organizacionDetalle.idMunicipio + ")";
        }
        catch { nombreMunicipioDisplay = "Error al cargar municipios"; }
    }

    private void Volver() => Nav.NavigateTo("/index-organizacion");
}

