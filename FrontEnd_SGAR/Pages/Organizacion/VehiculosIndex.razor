@code {
    private VehiculoResponsePaginada? response;
    private List<MarcaDto> marcas = new();
    private List<TipoVehiculoDto> tiposVehiculo = new();
    private Dictionary<int, string> operadores = new();
    private bool cargando = true;
    private int currentPage = 0;
    private int pageSize = 10;
    private string errorMessage = "";
    private FiltroVehiculoModel filtros = new();

    // Modal eliminar
    private bool mostrarModalEliminar = false;
    private VehiculoDetalleDto? vehiculoAEliminar;

    public class FiltroVehiculoModel
    {
        public string Placa { get; set; } = "";
        public string Codigo { get; set; } = "";
        public string MarcaId { get; set; } = "";
        public string TipoVehiculoId { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Mecanico { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[VehiculosIndex] Iniciando carga...");
        await CargarDatosIniciales();
        await CargarVehiculos();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            marcas = await VehiculoService.ObtenerMarcasAsync();
            tiposVehiculo = await VehiculoService.ObtenerTiposVehiculoAsync();
            operadores = await VehiculoService.ObtenerOperadoresConNombresAsync();

            Console.WriteLine($"✅ Datos iniciales - Marcas: {marcas.Count}, Tipos: {tiposVehiculo.Count}, Operadores: {operadores.Count}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos iniciales: {ex.Message}";
            Console.WriteLine($"[VehiculosIndex] Error datos iniciales: {ex.Message}");
        }
    }

    private async Task CargarVehiculos()
    {
        try
        {
            cargando = true;
            errorMessage = "";
            StateHasChanged();

            Console.WriteLine($"[VehiculosIndex] Cargando página {currentPage}, tamaño {pageSize}");

            response = await VehiculoService.ObtenerVehiculosAsync(
                currentPage,
                pageSize,
                filtros.Placa,
                filtros.Codigo,
                filtros.MarcaId,
                filtros.TipoVehiculoId,
                filtros.Estado,
                filtros.Mecanico);

            if (response != null)
            {
                // Cargar nombres de operadores e imágenes
                foreach (var vehiculo in response.Items)
                {
                    if (vehiculo.IdOperador.HasValue && operadores.ContainsKey(vehiculo.IdOperador.Value))
                    {
                        vehiculo.NombreOperador = operadores[vehiculo.IdOperador.Value];
                    }

                    if (vehiculo.IdFoto.HasValue && vehiculo.IdFoto.Value > 0)
                    {
                        vehiculo.ImagenBase64 = await VehiculoService.ObtenerImagenBase64Async(vehiculo.IdFoto.Value);
                    }
                }

                Console.WriteLine($"[VehiculosIndex] Response - Vehículos: {response.Items.Count}, Total: {response.TotalCount}");
            }
            else
            {
                errorMessage = "No se pudo obtener la respuesta del servidor";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar vehículos: {ex.Message}";
            Console.WriteLine($"[VehiculosIndex] Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltros()
    {
        currentPage = 0;
        await CargarVehiculos();
    }

    private async Task OnFilterKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AplicarFiltros();
        }
    }

    private async Task LimpiarFiltros()
    {
        filtros = new FiltroVehiculoModel();
        currentPage = 0;
        await CargarVehiculos();
    }

    private bool TieneFiltrosActivos()
    {
        return !string.IsNullOrEmpty(filtros.Placa) ||
               !string.IsNullOrEmpty(filtros.Codigo) ||
               !string.IsNullOrEmpty(filtros.MarcaId) ||
               !string.IsNullOrEmpty(filtros.TipoVehiculoId) ||
               !string.IsNullOrEmpty(filtros.Estado) ||
               !string.IsNullOrEmpty(filtros.Mecanico);
    }

    private async Task CambiarTamañoPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var nuevoTamaño))
        {
            pageSize = nuevoTamaño;
            currentPage = 0;
            await CargarVehiculos();
        }
    }

    private async Task NextPage()
    {
        if (response?.HasNextPage == true)
        {
            currentPage++;
            await CargarVehiculos();
        }
    }

    private async Task PrevPage()
    {
        if (response?.HasPreviousPage == true)
        {
            currentPage--;
            await CargarVehiculos();
        }
    }

    private void CrearNuevo() => Nav.NavigateTo("/vehiculos/crear");
    private void EditarVehiculo(int id) => Nav.NavigateTo($"/vehiculos/editar/{id}");

   private void ConfirmarEliminar(VehiculoDetalleDto vehiculo)
    {
        vehiculoAEliminar = vehiculo;
        mostrarModalEliminar = true;
        StateHasChanged(); // Forzar renderizado
    }

    // Método para cerrar
    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        vehiculoAEliminar = null;
    }

    // Método real que llama al servicio
    private async Task EliminarVehiculo()
    {
        if (vehiculoAEliminar == null) return;

        try
        {
            // Llamamos al nuevo método del servicio
            var resultado = await VehiculoService.EliminarVehiculoAsync(vehiculoAEliminar.Id);

            if (resultado.Exito)
            {
                CerrarModalEliminar();
                await CargarVehiculos();
            }
            else
            {
                // Aquí verás por qué falla realmente
                await JS.InvokeVoidAsync("alert", $"No se pudo eliminar: {resultado.Mensaje}");
                CerrarModalEliminar(); 
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error crítico: {ex.Message}");
        }
    }

    private async Task CerrarSesion()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login-admin", true);
    }
}