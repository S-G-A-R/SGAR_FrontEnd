@page "/vehiculos"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.DTOs
@using FrontEnd_SGAR.Providers
@using static FrontEnd_SGAR.DTOs.VehiculoDTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject VehiculoServices VehiculoService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<!-- Bootstrap Icons CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet" />

<div class="vehiculos-container">
    <div class="header-section">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-truck me-2"></i>Vehículos</h2>

            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="CrearNuevo">
                    <i class="bi bi-plus-circle me-1"></i>Crear Registro
                </button>
                <button class="btn btn-danger" @onclick="CerrarSesion">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </button>
            </div>
        </div>

        <!-- Filtros responsivos -->
        <div class="filtros-container">
            <div class="row g-3">
                <!-- Búsqueda por placa -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="input-group">
                        <input @bind="filtros.Placa" @onkeypress="OnFilterKeyPress" class="form-control" placeholder="Buscar por placa..." />
                        <button class="btn btn-outline-secondary" @onclick="AplicarFiltros">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>

                <!-- Código -->
                <div class="col-12 col-md-6 col-lg-3">
                    <input @bind="filtros.Codigo" @onkeypress="OnFilterKeyPress" class="form-control" placeholder="Código..." />
                </div>

                <!-- Marca -->
                <div class="col-12 col-md-4 col-lg-2">
                    <select @bind="filtros.MarcaId" @bind:after="AplicarFiltros" class="form-select">
                        <option value="">Todas las marcas</option>
                        @foreach (var marca in marcas)
                        {
                            <option value="@marca.Id">@marca.Nombre @marca.Modelo</option>
                        }
                    </select>
                </div>

                <!-- Tipo de vehículo -->
                <div class="col-12 col-md-4 col-lg-2">
                    <select @bind="filtros.TipoVehiculoId" @bind:after="AplicarFiltros" class="form-select">
                        <option value="">Todos los tipos</option>
                        @foreach (var tipo in tiposVehiculo)
                        {
                            <option value="@tipo.Id">@tipo.Descripcion</option>
                        }
                    </select>
                </div>

                <!-- Estado y página -->
                <div class="col-12 col-md-4 col-lg-2">
                    <div class="d-flex gap-2">
                        <select @bind="filtros.Estado" @bind:after="AplicarFiltros" class="form-select">
                            <option value="">Todos</option>
                            <option value="1">Activos</option>
                            <option value="0">Inactivos</option>
                        </select>

                        <select @onchange="CambiarTamañoPagina" class="form-select" value="@pageSize" style="min-width: 80px;">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (TieneFiltrosActivos())
            {
                <div class="mt-3 text-center">
                    <button class="btn btn-outline-danger btn-sm" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                    </button>
                    <small class="text-muted ms-2">@(response?.TotalCount ?? 0) resultado(s) encontrado(s)</small>
                </div>
            }
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando vehículos...</p>
        </div>
    }
    else if (response == null || !response.Items.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay vehículos registrados.
        </div>
    }
    else
    {
        <!-- Contenido de vehículos igual que antes pero usando response.Items -->
        <!-- Vista de escritorio (tarjetas) -->
        <div class="vehiculos-grid d-none d-lg-grid">
            @foreach (var vehiculo in response.Items)
            {
                <div class="vehiculo-card">
                    <div class="vehiculo-imagen">
                        @if (!string.IsNullOrEmpty(vehiculo.ImagenBase64))
                        {
                            <img src="data:image/jpeg;base64,@vehiculo.ImagenBase64" alt="Imagen Vehículo" />
                        }
                        else
                        {
                            <div class="no-imagen">
                                <i class="bi bi-truck" style="font-size: 3rem; color: #ccc;"></i>
                                <p>Sin imagen</p>
                            </div>
                        }
                    </div>

                    <div class="vehiculo-info">
                        <div class="info-row">
                            <span class="label">Marca:</span>
                            <div class="marca-badges">
                                <span class="badge badge-yellow">@vehiculo.NombreMarca</span>
                                <span class="badge badge-green">@vehiculo.ModeloMarca</span>
                                <span class="badge badge-red">@vehiculo.TipoVehiculoDescripcion</span>
                            </div>
                        </div>

                        <div class="info-row">
                            <span class="label">Placa:</span>
                            <span class="value">@vehiculo.Placa</span>
                        </div>

                        <div class="info-row">
                            <span class="label">Código:</span>
                            <span class="value">@vehiculo.Codigo</span>
                        </div>

                        <div class="info-row">
                            <span class="label">Estado:</span>
                            <span class="value">
                                @if (vehiculo.Estado == 1)
                                {
                                    <span class="estado-badge activo">
                                        <i class="bi bi-check-circle me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="estado-badge inactivo">
                                        <i class="bi bi-x-circle me-1"></i>Inactivo
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="label">Conductor:</span>
                            <span class="value conductor-name">
                                @if (!string.IsNullOrEmpty(vehiculo.NombreOperador))
                                {
                                    <span class="conductor-badge">
                                        <i class="bi bi-person-circle me-1"></i>
                                        @vehiculo.NombreOperador
                                    </span>
                                }
                                else
                                {
                                    <span class="sin-conductor">Sin asignar</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="vehiculo-actions">
                        <button class="action-btn edit-btn" @onclick="() => EditarVehiculo(vehiculo.Id)" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="action-btn delete-btn" @onclick="() => ConfirmarEliminar(vehiculo)" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Vista móvil y tablets (lista) -->
        <div class="vehiculos-list d-lg-none">
            @foreach (var vehiculo in response.Items)
            {
                <div class="vehiculo-item-mobile">
                    <div class="vehiculo-mobile-header">
                        <div class="vehiculo-mobile-image">
                            @if (!string.IsNullOrEmpty(vehiculo.ImagenBase64))
                            {
                                <img src="data:image/jpeg;base64,@vehiculo.ImagenBase64" alt="Imagen Vehículo" />
                            }
                            else
                            {
                                <div class="no-imagen-mobile">
                                    <i class="bi bi-truck"></i>
                                </div>
                            }
                        </div>

                        <div class="vehiculo-mobile-basic">
                            <h5 class="mb-1">@vehiculo.Placa</h5>
                            <p class="mb-1 text-muted">Código: @vehiculo.Codigo</p>
                            <div class="mobile-badges">
                                <span class="badge bg-primary">@vehiculo.NombreMarca @vehiculo.ModeloMarca</span>
                                <span class="badge bg-secondary">@vehiculo.TipoVehiculoDescripcion</span>
                            </div>
                        </div>

                        <div class="vehiculo-mobile-status">
                            @if (vehiculo.Estado == 1)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(vehiculo.NombreOperador))
                    {
                        <div class="vehiculo-mobile-operator">
                            <i class="bi bi-person-circle me-2"></i>
                            <span>@vehiculo.NombreOperador</span>
                        </div>
                    }

                    <div class="vehiculo-mobile-actions">
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => EditarVehiculo(vehiculo.Id)">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(vehiculo)">
                            <i class="bi bi-trash me-1"></i>Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        <div class="pagination-container mt-3 d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(!response.HasPreviousPage)"
                    @onclick="PrevPage">
                ◀ Anterior
            </button>

            <span class="fw-bold page-info">
                Página @(response.PageNumber + 1) de @response.TotalPages | Total: @response.TotalCount vehículos
            </span>

            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@(!response.HasNextPage)"
                    @onclick="NextPage">
                Siguiente ▶
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
        </div>
    }

    @if (mostrarModalEliminar && vehiculoAEliminar != null)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <div class="modal-header-delete">
                    <h5 class="m-0 text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-2">¿Estás seguro que deseas eliminar el vehículo?</p>
                    <div class="alert alert-warning d-inline-block p-2 mt-2">
                        <strong>@vehiculoAEliminar.Placa</strong> - @vehiculoAEliminar.NombreMarca @vehiculoAEliminar.ModeloMarca
                    </div>
                    <p class="text-danger small mt-3 mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-cancelar" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button type="button" class="btn-continuar" @onclick="EliminarVehiculo">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                </div>
            </div>
        </div>
    }
</div>


