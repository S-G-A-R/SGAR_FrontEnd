@code {
    private List<VehiculoDto> vehiculos = new();
    private Dictionary<int, string> operadores = new();
    private List<MarcaDto> marcas = new();
    private List<TipoVehiculoDto> tiposVehiculo = new();
    private bool cargando = true;
    private int currentPage = 0;
    private int totalPages = 0;
    private int totalElements = 0;
    private int pageSize = 10;

    // Filtros estructurados
    private FiltroVehiculoModel filtros = new();

    // Modal eliminar
    private bool mostrarModalEliminar = false;
    private VehiculoDto? vehiculoAEliminar;

    public class FiltroVehiculoModel
    {
        public string Placa { get; set; } = "";
        public string Codigo { get; set; } = "";
        public string MarcaId { get; set; } = "";
        public string TipoVehiculoId { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Mecanico { get; set; } = "";
    }

    public class VehiculoDto
    {
        public int Id { get; set; }
        public string NombreMarca { get; set; } = "";
        public string ModeloMarca { get; set; } = "";
        public string Placa { get; set; } = "";
        public string Codigo { get; set; } = "";
        public string TipoVehiculoDescripcion { get; set; } = "";
        public int? IdOperador { get; set; }
        public int? IdFoto { get; set; }
        public string NombreOperador { get; set; } = "";
        public string ImagenBase64 { get; set; } = "";
        public byte Estado { get; set; }
    }

    public class OperadorDto
    {
        public int Id { get; set; }
        public int IdUser { get; set; }
        public string CodigoOperador { get; set; } = "";
        public int IdOrganizacion { get; set; }
    }

    public class UserDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Apellido { get; set; } = "";
        public string Email { get; set; } = "";
    }

    public class MarcaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Modelo { get; set; } = "";
    }

    public class TipoVehiculoDto
    {
        public int Id { get; set; }
        public string Descripcion { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosIniciales();
        await CargarVehiculos();
    }

    private async Task CargarDatosIniciales()
    {
        var tasks = new[]
        {
            CargarOperadores(),
            CargarMarcas(),
            CargarTiposVehiculo()
        };

        await Task.WhenAll(tasks);
    }

    private async Task CargarOperadores()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var operadorResponse = await Http.GetStringAsync("api/operador/list?size=100");
            var operadorData = JsonSerializer.Deserialize<JsonElement>(operadorResponse);

            if (operadorData.TryGetProperty("content", out var operadorContent) || 
                operadorData.TryGetProperty("items", out operadorContent))
            {
                var operadoresList = JsonSerializer.Deserialize<List<OperadorDto>>(operadorContent.GetRawText(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                foreach (var operador in operadoresList)
                {
                    try
                    {
                        var userResponse = await Http.GetStringAsync($"api/user/{operador.IdUser}");
                        var userData = JsonSerializer.Deserialize<UserDto>(userResponse,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                        if (userData != null)
                        {
                            operadores[operador.Id] = $"{userData.Nombre} {userData.Apellido}".Trim();
                        }
                    }
                    catch
                    {
                        operadores[operador.Id] = operador.CodigoOperador;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando operadores: {ex.Message}");
        }
    }

