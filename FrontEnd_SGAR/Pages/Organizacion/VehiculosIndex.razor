    private async Task CargarVehiculos()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            var client = ClientFactory.CreateClient("JavaAPI");
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            // Construir URL con todos los filtros
            var url = $"api/vehiculos?page={currentPage}&size={pageSize}";
            
            if (!string.IsNullOrEmpty(filtros.Placa))
                url += $"&placa={Uri.EscapeDataString(filtros.Placa)}";
                
            if (!string.IsNullOrEmpty(filtros.Codigo))
                url += $"&codigo={Uri.EscapeDataString(filtros.Codigo)}";
                
            if (!string.IsNullOrEmpty(filtros.MarcaId))
                url += $"&marcaId={filtros.MarcaId}";
                
            if (!string.IsNullOrEmpty(filtros.TipoVehiculoId))
                url += $"&tipoVehiculoId={filtros.TipoVehiculoId}";
                
            if (!string.IsNullOrEmpty(filtros.Estado))
                url += $"&estado={filtros.Estado}";
                
            if (!string.IsNullOrEmpty(filtros.Mecanico))
                url += $"&mecanico={Uri.EscapeDataString(filtros.Mecanico)}";

            Console.WriteLine($"🔍 URL de búsqueda: {url}");
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                var pageResponse = JsonSerializer.Deserialize<JsonElement>(jsonContent);

                if (pageResponse.TryGetProperty("content", out var contentArray))
                {
                    var vehiculosRaw = JsonSerializer.Deserialize<List<VehiculoDto>>(contentArray.GetRawText(),
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                    // Procesar cada vehículo
                    foreach (var vehiculo in vehiculosRaw)
                    {
                        // Asignar nombre del operador
                        if (vehiculo.IdOperador.HasValue && operadores.ContainsKey(vehiculo.IdOperador.Value))
                        {
                            vehiculo.NombreOperador = operadores[vehiculo.IdOperador.Value];
                        }

                        // Cargar imagen como Base64
                        if (vehiculo.IdFoto.HasValue && vehiculo.IdFoto.Value > 0)
                        {
                            try
                            {
                                var imageResponse = await client.GetAsync($"api/fotos/{vehiculo.IdFoto.Value}/imagen");
                                
                                if (imageResponse.IsSuccessStatusCode)
                                {
                                    var imageBytes = await imageResponse.Content.ReadAsByteArrayAsync();
                                    vehiculo.ImagenBase64 = Convert.ToBase64String(imageBytes);
                                }
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"❌ Error cargando imagen para vehículo {vehiculo.Id}: {ex.Message}");
                            }
                        }
                    }

                    vehiculos = vehiculosRaw;
                    totalPages = pageResponse.TryGetProperty("totalPages", out var pages) ? pages.GetInt32() : 0;
                    totalElements = pageResponse.TryGetProperty("totalElements", out var elements) ? elements.GetInt32() : 0;
                    currentPage = pageResponse.TryGetProperty("number", out var number) ? number.GetInt32() : 0;

                    Console.WriteLine($"📊 Página {currentPage + 1}/{totalPages} - {vehiculos.Count} vehículos - Total: {totalElements}");
                }
            }
            else
            {
                Console.WriteLine($"❌ Error API vehiculos: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"💥 Error cargando vehículos: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltros()
    {
        currentPage = 0;
        await CargarVehiculos();
    }

    private async Task OnFilterKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AplicarFiltros();
        }
    }

    private async Task LimpiarFiltros()
    {
        filtros = new FiltroVehiculoModel();
        currentPage = 0;
        await CargarVehiculos();
    }

    private bool TieneFiltrosActivos()
    {
        return !string.IsNullOrEmpty(filtros.Placa) ||
               !string.IsNullOrEmpty(filtros.Codigo) ||
               !string.IsNullOrEmpty(filtros.MarcaId) ||
               !string.IsNullOrEmpty(filtros.TipoVehiculoId) ||
               !string.IsNullOrEmpty(filtros.Estado) ||
               !string.IsNullOrEmpty(filtros.Mecanico);
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 0 && nuevaPagina < totalPages)
        {
            currentPage = nuevaPagina;
            await CargarVehiculos();
        }
    }

    private async Task CambiarTamañoPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var nuevoTamaño))
        {
            pageSize = nuevoTamaño;
            currentPage = 0;
            await CargarVehiculos();
            StateHasChanged();
        }
    }

