@page "/MenuOperador"
@inject NavigationManager Navigation

<div class="container text-center p-5">
    <div class="row align-items-center">

        <!-- Horarios -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-25">
                            <i class="bi bi-calendar2-week-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Horarios</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

        <!-- Mantenimiento -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-50">
                            <i class="bi bi-file-earmark-richtext-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Mantenimiento</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

        <!-- Ubicación -->
        <div class="col">
            <div class="contenedor-tarjeta">
                <div class="card" style="width: 18rem;">
                    <div class="card-body" @onclick="Error">
                        <NavLink class="card-link w-50">
                            <i class="bi bi-geo-alt-fill" style="font-size: 3rem; color: ThreeDDarkShadow"></i>
                        </NavLink>
                        <h3>Ubicación</h3>
                        <div class="tarjeta-flecha">Ir ahí <i class="bi bi-arrow-right"></i></div>
                    </div>
                </div>
                <img src="css/orejaIz.png" alt="Oreja izquierda" class="oreja oreja-izquierda">
                <img src="css/orejaDe.png" alt="Oreja derecha" class="oreja oreja-derecha">
            </div>
        </div>

    </div>

</div>


@code {

    private void Error()
    {
        Navigation.NavigateTo("/sgarMantenimiento");
    }

}
