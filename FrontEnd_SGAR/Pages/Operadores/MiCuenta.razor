@page "/mi-cuenta"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http              // API Seguridad
@inject IHttpClientFactory ClientFactory  // API Java

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">

        <h3><i class="bi bi-person-badge me-2"></i>Mi Cuenta</h3>
        <hr />

        <div class="d-flex align-items-center mb-4" style="gap: 20px;">
            <div class="avatar-container">
                <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" />
            </div>

            <div>
                <div class="title-label">@NombreCompleto</div>
                <div class="text-muted" style="font-size: 16px;">@CodigoOperador</div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label>Zona asignada</label>
                <div class="dato-box">@ZonaAsignada</div>
            </div>

            <div class="col-md-6">
                <label>DUI</label>
                <div class="dato-box">@Dui</div>
            </div>

            <div class="col-md-6">
                <label>Correo electrónico</label>
                <div class="dato-box">@Correo</div>
            </div>

            <div class="col-md-6">
                <label>Vehículo asignado</label>
                <div class="dato-box">@Vehiculo</div>
            </div>

            <div class="col-md-6">
                <label>Placa</label>
                <div class="dato-box">@Placa</div>
            </div>

            <div class="col-md-6">
                <label>Código vehículo</label>
                <div class="dato-box">@CodigoVehiculo</div>
            </div>
        </div>

        <div class="botones mt-5" style="text-align:center;">
            <div class="contenedor-boton">
                <button class="boton-mapacheAceptar" @onclick="Volver">Volver</button>
                @* Asegúrate de que estas imágenes existan en tu wwwroot/css *@
                <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                <img src="css/orejaIz.png" class="oreja oreja-derecha" />
            </div>
            <button class="btn-cancelar" @onclick="CerrarSesion">Cerrar sesión</button>
        </div>

    </div>
</div>

<style>
    .avatar-container {
        width: 140px;
        height: 140px;
        border: 3px solid #2c7be5;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .avatar-container img {
            width: 80px;
            opacity: 0.9;
        }

    .title-label {
        font-size: 18px;
        font-weight: bold;
    }

    .dato-box {
        background: #d9d9d9;
        border: 2px solid #b5b5b5;
        border-radius: 10px;
        padding: 10px 15px;
        width: 100%;
        font-size: 16px;
        pointer-events: none;
    }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        margin-left: 15px;
        height: 48px;
        cursor: pointer;
        transition: .2s;
    }

        .btn-cancelar:hover {
            background-color: #5a6268;
        }
</style>

@code {
    // Variables de la vista
    private string NombreCompleto { get; set; } = "Cargando...";
    private string CodigoOperador { get; set; } = "—";
    private string ZonaAsignada { get; set; } = "—";
    private string Dui { get; set; } = "—";
    private string Correo { get; set; } = "—";
    private string Vehiculo { get; set; } = "—";
    private string Placa { get; set; } = "—";
    private string CodigoVehiculo { get; set; } = "—";

    // --- DTOs ---
    public class UserDTO
    {
        public int id { get; set; }
        public string nombre { get; set; }
        public string apellido { get; set; }
        public string email { get; set; }
        public string dui { get; set; }
    }

    public class OperadorDTO
    {
        public int id { get; set; }
        public int idUser { get; set; }
        public string codigoOperador { get; set; }
        public int idOrganizacion { get; set; }
    }

    public class VehiculoDTO
    {
        public int id { get; set; }
        public string placa { get; set; }
        public string codigo { get; set; }

        // OJO AQUÍ: A veces Java lo manda como 'tipoVehiculo' o 'descripcion'
        // Si sigue saliendo vacío, veremos el JSON en la consola para corregir este nombre
        public string tipoVehiculoDescripcion { get; set; }

        public int idOperador { get; set; }
    }

    // CLASE CORREGIDA: Ahora usamos 'items' porque así lo manda tu API
    public class PageResponse<T>
    {
        public List<T> items { get; set; }
        public int pageNumber { get; set; }
        public int totalPages { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            // 1. ID USUARIO
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (string.IsNullOrEmpty(userIdString)) { Nav.NavigateTo("/", true); return; }
            int userId = int.Parse(userIdString);

            // 2. CARGAR USUARIO
            try
            {
                var usuario = await Http.GetFromJsonAsync<UserDTO>($"api/user/{userId}");
                if (usuario != null)
                {
                    NombreCompleto = $"{usuario.nombre} {usuario.apellido}";
                    Correo = usuario.email;
                    Dui = usuario.dui;
                }
            }
            catch (Exception) { }

            // 3. BUSCAR OPERADOR
            OperadorDTO operador = null;
            try
            {
                // Configuración para ignorar mayúsculas/minúsculas
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

                // Traemos la lista cruda
                var responseString = await Http.GetStringAsync("api/operador/list?size=100");
                var pagina = JsonSerializer.Deserialize<PageResponse<OperadorDTO>>(responseString, options);

                if (pagina != null && pagina.items != null)
                {
                    operador = pagina.items.FirstOrDefault(o => o.idUser == userId);
                }
            }
            catch (Exception ex) { Console.WriteLine("Error Operador: " + ex.Message); }

            // 4. CARGAR VEHÍCULO
            if (operador != null)
            {
                CodigoOperador = operador.codigoOperador;
                ZonaAsignada = operador.idOrganizacion.ToString();

                var java = ClientFactory.CreateClient("JavaAPI");
                try
                {
                    // A) Pedimos el JSON crudo para ver qué devuelve Java
                    string url = $"api/vehiculos/operador/{operador.id}";
                    var jsonVehiculo = await java.GetStringAsync(url);

                    // 🔥 ESTO SALDRÁ EN CONSOLA: Mándame esto si sigue fallando
                    Console.WriteLine("JSON VEHICULO RECIBIDO: " + jsonVehiculo);

                    // B) Deserializamos ignorando mayúsculas (Magia pura)
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var listaVehiculos = JsonSerializer.Deserialize<List<VehiculoDTO>>(jsonVehiculo, options);

                    if (listaVehiculos != null && listaVehiculos.Count > 0)
                    {
                        var asignado = listaVehiculos.First();

                        // Asignamos variables
                        Placa = asignado.placa;
                        CodigoVehiculo = asignado.codigo;

                        // Validamos si viene la descripción o ponemos un texto por defecto
                        Vehiculo = string.IsNullOrEmpty(asignado.tipoVehiculoDescripcion)
                                   ? "Vehículo Detectado (Verificar nombre campo)"
                                   : asignado.tipoVehiculoDescripcion;
                    }
                    else
                    {
                        Vehiculo = "Sin Vehículo Asignado";
                        Placa = "—";
                        CodigoVehiculo = "—";
                    }
                }
                catch (Exception exJava)
                {
                    Console.WriteLine("Error leyendo vehículo: " + exJava.Message);
                    Vehiculo = "Error API";
                }
            }
            else
            {
                CodigoOperador = "No encontrado";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR GENERAL: " + ex.Message);
        }
    }

    private void Volver() => Nav.NavigateTo("/mi-cuenta");
    private async Task CerrarSesion() { await JS.InvokeVoidAsync("localStorage.clear"); Nav.NavigateTo("/login-operador", true); }
}




