                var vehiculos = pageResponse?.content;

                if (vehiculos != null)
                {
                    var asignado = vehiculos.FirstOrDefault(v => v.idOperador == operador.id);

                    if (asignado != null)
                    {
                        Vehiculo = asignado.tipoVehiculoDescripcion;
                        Placa = asignado.placa;
                        CodigoVehiculo = asignado.codigo;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("ERROR MiCuenta: " + ex.Message);
            }
