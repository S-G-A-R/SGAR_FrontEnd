@page "/mi-cuenta"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Net.Http.Headers
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http              // API Seguridad
@inject IHttpClientFactory ClientFactory  // API Java

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">

        <h3><i class="bi bi-person-badge me-2"></i>Mi Cuenta</h3>
        <hr />

        <div class="d-flex align-items-center mb-4" style="gap: 20px;">
            <div class="avatar-container">
                <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" />
            </div>

            <div>
                <div class="title-label">@NombreCompleto</div>
                <div class="text-muted" style="font-size: 16px;">@CodigoOperador</div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label>Zona asignada</label>
                <div class="dato-box">@ZonaAsignada</div>
            </div>

            <div class="col-md-6">
                <label>DUI</label>
                <div class="dato-box">@Dui</div>
            </div>

            <div class="col-md-6">
                <label>Correo electrónico</label>
                <div class="dato-box">@Correo</div>
            </div>

            <div class="col-md-6">
                <label>Vehículo asignado</label>
                <div class="dato-box">@Vehiculo</div>
            </div>

            <div class="col-md-6">
                <label>Placa</label>
                <div class="dato-box">@Placa</div>
            </div>

            <div class="col-md-6">
                <label>Código vehículo</label>
                <div class="dato-box">@CodigoVehiculo</div>
            </div>
        </div>

        <div class="botones mt-5" style="text-align:center;">
            <div class="contenedor-boton">
                <button class="boton-mapacheAceptar" @onclick="Volver">Volver</button>
                <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                <img src="css/orejaIz.png" class="oreja oreja-derecha" />
            </div>
            <button class="btn-cancelar" @onclick="CerrarSesion">Cerrar sesión</button>
        </div>

    </div>
</div>

<style>
    .avatar-container {
        width: 140px;
        height: 140px;
        border: 3px solid #2c7be5;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .avatar-container img {
            width: 80px;
            opacity: 0.9;
        }

    .title-label {
        font-size: 18px;
        font-weight: bold;
    }

    .dato-box {
        background: #d9d9d9;
        border: 2px solid #b5b5b5;
        border-radius: 10px;
        padding: 10px 15px;
        width: 100%;
        font-size: 16px;
        pointer-events: none;
    }

    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        margin-left: 15px;
        height: 48px;
        cursor: pointer;
        transition: .2s;
    }

        .btn-cancelar:hover {
            background-color: #5a6268;
        }
</style>

@code {
    private string NombreCompleto { get; set; } = "Cargando...";
    private string CodigoOperador { get; set; } = "—";
    private string ZonaAsignada { get; set; } = "—";
    private string Dui { get; set; } = "—";
    private string Correo { get; set; } = "—";
    private string Vehiculo { get; set; } = "—";
    private string Placa { get; set; } = "—";
    private string CodigoVehiculo { get; set; } = "—";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            // 1. Obtener userId
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (string.IsNullOrEmpty(userIdString))
            {
                Nav.NavigateTo("/", true);
                return;
            }
            int userId = int.Parse(userIdString);

            // 2. Cargar datos del usuario
            await CargarUsuario(userId);

            // 3. Cargar datos del operador y vehículo
            await CargarOperadorYVehiculo(userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR: " + ex.Message);
        }
    }

    private async Task CargarUsuario(int userId)
    {
        try
        {
            // Configurar token
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.GetStringAsync($"api/user/{userId}");
            var usuario = JsonSerializer.Deserialize<JsonElement>(response);

            NombreCompleto = $"{usuario.GetProperty("nombre").GetString()} {usuario.GetProperty("apellido").GetString()}";
            Correo = usuario.GetProperty("email").GetString();
            Dui = usuario.GetProperty("dui").GetString();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error usuario: " + ex.Message);
        }
    }

    private async Task CargarOperadorYVehiculo(int userId)
    {
        try
        {
            // 1. Buscar operador por userId
            var operadorResponse = await Http.GetStringAsync("api/operador/list?size=100");
            var operadorData = JsonSerializer.Deserialize<JsonElement>(operadorResponse);

            JsonElement operador = default;
            bool operadorEncontrado = false;

            // Buscar en content o items
            if (operadorData.TryGetProperty("content", out var content))
            {
                foreach (var op in content.EnumerateArray())
                {
                    if (op.GetProperty("idUser").GetInt32() == userId)
                    {
                        operador = op;
                        operadorEncontrado = true;
                        break;
                    }
                }
            }
            else if (operadorData.TryGetProperty("items", out var items))
            {
                foreach (var op in items.EnumerateArray())
                {
                    if (op.GetProperty("idUser").GetInt32() == userId)
                    {
                        operador = op;
                        operadorEncontrado = true;
                        break;
                    }
                }
            }

            if (!operadorEncontrado)
            {
                Console.WriteLine("Operador no encontrado");
                return;
            }

            // Asignar datos del operador
            CodigoOperador = operador.GetProperty("codigoOperador").GetString();
            ZonaAsignada = $"Zona {operador.GetProperty("idOrganizacion").GetInt32()}";
            int operadorId = operador.GetProperty("id").GetInt32();

            // 2. Cargar vehículo del operador
            await CargarVehiculo(operadorId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error operador: " + ex.Message);
        }
    }

    private async Task CargarVehiculo(int operadorId)
    {
        try
        {
            var javaClient = ClientFactory.CreateClient("JavaAPI");

            // Configurar token
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                javaClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            // Llamar al endpoint específico
            var vehiculoResponse = await javaClient.GetStringAsync($"api/vehiculos/operador/{operadorId}");
            Console.WriteLine("Vehículo JSON: " + vehiculoResponse);

            var vehiculoArray = JsonSerializer.Deserialize<JsonElement[]>(vehiculoResponse);

            if (vehiculoArray != null && vehiculoArray.Length > 0)
            {
                var vehiculo = vehiculoArray[0];

                // Extraer datos exactos del JSON
                Placa = vehiculo.GetProperty("placa").GetString();
                CodigoVehiculo = vehiculo.GetProperty("codigo").GetString();

                // Para el vehículo, usar tipoVehiculoDescripcion o marca+modelo
                if (vehiculo.TryGetProperty("tipoVehiculoDescripcion", out var tipoDesc))
                {
                    Vehiculo = tipoDesc.GetString();
                }
                else if (vehiculo.TryGetProperty("nombreMarca", out var marca))
                {
                    var modelo = vehiculo.TryGetProperty("modeloMarca", out var mod) ? mod.GetString() : "";
                    Vehiculo = $"{marca.GetString()} {modelo}".Trim();
                }
                else
                {
                    Vehiculo = "Vehículo Asignado";
                }

                Console.WriteLine($"Vehículo cargado - Placa: {Placa}, Código: {CodigoVehiculo}");
            }
            else
            {
                Vehiculo = "Sin Vehículo";
                Placa = "—";
                CodigoVehiculo = "—";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error vehículo: " + ex.Message);
            Vehiculo = "Error cargando";
        }
    }

    private void Volver() => Nav.NavigateTo("/dashboard-operador");

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.clear");
        Nav.NavigateTo("/login-operador", true);
    }
}