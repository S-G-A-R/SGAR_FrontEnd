@page "/mi-cuenta"
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">

        <!-- Título -->
        <h3><i class="bi bi-person-badge me-2"></i>Mi Cuenta</h3>
        <hr />

        <!-- HEADER: Avatar + Nombre -->
        <div class="d-flex align-items-center mb-4" style="gap: 20px;">

            <div class="avatar-container">
                <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" />
            </div>

            <div>
                <div class="title-label">Nombre Operador</div>
                <div class="text-muted" style="font-size: 16px;">Código Operador</div>
            </div>
        </div>

        <!-- DATOS -->
        <div class="row g-4">

            <div class="col-md-6">
                <label>Zona asignada</label>
                <div class="dato-box">@ZonaAsignada</div>
            </div>

            <div class="col-md-6">
                <label>DUI</label>
                <div class="dato-box">@Dui</div>
            </div>

            <div class="col-md-6">
                <label>Correo electrónico</label>
                <div class="dato-box">@Correo</div>
            </div>

            <div class="col-md-6">
                <label>Vehículo asignado</label>
                <div class="dato-box">@Vehiculo</div>
            </div>

            <div class="col-md-6">
                <label>Placa</label>
                <div class="dato-box">@Placa</div>
            </div>

            <div class="col-md-6">
                <label>Código vehículo</label>
                <div class="dato-box">@CodigoVehiculo</div>
            </div>

        </div>

        <!-- BOTONES -->
        <div class="botones mt-5" style="text-align:center;">

            <div class="contenedor-boton">
                <button class="boton-mapacheAceptar" @onclick="Volver">Volver</button>
                <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                <img src="css/orejaIz.png" class="oreja oreja-derecha" />
            </div>

            <button class="btn-cancelar" @onclick="CerrarSesion">Cerrar sesión</button>
        </div>

    </div>
</div>

<style>

    /* Avatar redondo estilo alcaldía */
    .avatar-container {
        width: 140px;
        height: 140px;
        border: 3px solid #2c7be5;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .avatar-container img {
            width: 80px;
            opacity: 0.9;
        }

    .title-label {
        font-size: 18px;
        font-weight: bold;
    }

    /* Caja gris para mostrar datos */
    .dato-box {
        background: #d9d9d9;
        border: 2px solid #b5b5b5;
        border-radius: 10px;
        padding: 10px 15px;
        width: 100%;
        font-size: 16px;
        pointer-events: none;
    }

    /* Botón cancelar estilo alcaldía */
    .btn-cancelar {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        margin-left: 15px;
        height: 48px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-cancelar:hover {
            background-color: #5a6268;
        }

</style>

@code {

    private string ZonaAsignada { get; set; } = "Lourdes";
    private string Dui { get; set; } = "00000000-0";
    private string Correo { get; set; } = "AJP01@alcaldia.sv";
    private string Vehiculo { get; set; } = "Tipo 2";
    private string Placa { get; set; } = "N 239-098";
    private string CodigoVehiculo { get; set; } = "INT-0001";

    private void Volver()
    {
        Nav.NavigateTo("/home");
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.clear");
        Nav.NavigateTo("/", true);
    }
}