@page "/horarios"
@using FrontEnd_SGAR.Services
@using FrontEnd_SGAR.Models
@inject HorarioService HorarioService
@inject NavigationManager Nav

<link href="css/registro-organizacion.css" rel="stylesheet" />

<div class="registro-container">
    <div class="registro-card">

        <h3><i class="bi bi-calendar-week me-2"></i>Horarios</h3>
        <hr />

        @if (isLoading)
        {
            <div class="text-center mt-4">
                <div class="spinner-border text-primary"></div>
                <p>Cargando horarios...</p>
            </div>
        }
        else if (horarios.Count == 0)
        {
            <div class="text-center mt-4">
                <i class="bi bi-calendar-x" style="font-size:40px;color:#888"></i>
                <p class="mt-2">No hay horarios registrados.</p>
            </div>
        }
        else
        {
            @foreach (var h in horarios)
            {
                <div class="horario-item d-flex align-items-center mt-4">
                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" class="icono-horario" />

                    <div class="info-container">
                        <div class="horario-title">
                            Zona: @h.ZonaId
                        </div>

                        <div class="horario-box p-2">
                            <div><strong>Día:</strong> @h.Dia</div>
                            <div><strong>Entrada:</strong> @h.HoraEntrada</div>
                            <div><strong>Salida:</strong> @h.HoraSalida</div>
                            <div><strong>Turno:</strong> @ObtenerTurno(h.Turno)</div>
                        </div>
                    </div>
                </div>
            }
        }

        <div class="botones mt-5" style="text-align:center;">
            <div class="contenedor-boton">
                <button class="boton-mapacheAceptar" @onclick="Volver">Volver</button>
                <img src="css/orejaIz.png" class="oreja oreja-izquierda" />
                <img src="css/orejaIz.png" class="oreja oreja-derecha" />
            </div>
        </div>

    </div>
</div>

<style>
    .horario-item {
        gap: 25px;
        padding: 15px 5px;
    }

    .icono-horario {
        width: 90px;
        opacity: 0.9;
    }

    .info-container {
        width: 100%;
    }

    .horario-title {
        font-size: 18px;
        font-weight: bold;
        letter-spacing: .3px;
        margin-bottom: 10px;
        color: #333;
    }

    .horario-box {
        background: #e4e8ee;
        border: 2px solid #c6ccd3;
        border-radius: 10px;
        min-height: 80px;
        font-size: 14px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
</style>

@code {
    private List<HorarioDTO> horarios = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarHorarios();
    }

    private async Task CargarHorarios()
    {
        try
        {
            isLoading = true;

            // Filtro vacío para traer todo
            var filtro = new FiltroHorario
            {
                Page = 1,
                Size = 100
            };

            var resp = await HorarioService.ObtenerHorariosAsync(filtro);
            horarios = resp?.Items ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando horarios: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/mi-cuenta");
    }

    private string ObtenerTurno(byte turno)
    {
        return turno switch
        {
            1 => "Mañana 🌅",
            2 => "Tarde ☀",
            3 => "Noche 🌙",
            _ => "Desconocido"
        };
    }
}




