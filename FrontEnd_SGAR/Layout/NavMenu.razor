@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FrontEnd_SGAR.Providers
@using System.Security.Claims
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@attribute [Authorize]

<nav class="navbar navbar-light bg-white shadow-sm">
    <div class="container-fluid">
        <!-- Botón menú offcanvas -->
        <button class="navbar-toggler p-2 me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Logo SGAR -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="css/sgarLetra.png" alt="SGAR" width="90" height="30" class="me-2" href="/" />
        </a>

        <!-- Dropdown Iniciar Sesión -->
        <div class="ms-auto">
            <AuthorizeView>

                <Authorized>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-none d-md-inline fw-bold">
                                <!--Nombre del autenticado-->
                                @context.User.Identity.Name
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <h6 class="dropdown-header">
                                    <!-- Rol del autenticado -->
                                    Rol: @(context.User.FindFirst(ClaimTypes.Role)?.Value ?? context.User.FindFirst("role")?.Value)
                                </h6>
                            </li>
                            <li><hr class="dropdown-divider"></li>

                            <!-- Botón para ADMINISTRADOR -->
                            <AuthorizeView Roles="Administrador" Context="innerContext">
                                <li>
                                    <a class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuAdmin")'>
                                        <i class="bi bi-shield-lock-fill me-2 text-danger"></i> Menu Admininitrador
                                    </a>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para ASOCIADO -->
                            <AuthorizeView Roles="Asociado" Context="innerContext">
                                <li>
                                    <a class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuAsociado")'>
                                        <i class="bi bi-briefcase-fill me-2 text-primary"></i> Menu Asociado
                                    </a>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para OPERADOR -->
                            <AuthorizeView Roles="Operador" Context="innerContext">
                                <li>
                                    <a class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuOperador")'>
                                        <i class="bi bi-truck me-2 text-warning"></i> Menu Operador
                                    </a>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para ORGANIZACIÓN -->
                            <AuthorizeView Roles="Organizacion" Context="innerContext">
                                <li>
                                    <a class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuOrganizacion")'>
                                        <i class="bi bi-building-fill me-2 text-info"></i> Menu Organización
                                    </a>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para CIUDADANO -->
                            <AuthorizeView Roles="Ciudadano" Context="innerContext">
                                <li>
                                    <a class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuCiudadano")'>
                                        <i class="bi bi-person-badge me-2 text-success"></i> Menú Ciudadano
                                    </a>
                                </li>
                            </AuthorizeView>

                            <li>
                                <button class="dropdown-item text-danger" @onclick="CerrarSesion">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>

                </Authorized>

                <NotAuthorized>
                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Iniciar Sesión
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/login-ciudadano">Ciudadano</a></li>
                            <li><a class="dropdown-item" href="/login-admin">Administrador</a></li>
                            <li><a class="dropdown-item" href="/login-organizacion">Organización</a></li>
                            <li><a class="dropdown-item" href="/login-asociado">Asociado</a></li>
                            <li><a class="dropdown-item" href="/login-operador">Operador</a></li>
                        </ul>
                    </div>
                </NotAuthorized>

            </AuthorizeView>
        </div>

        <!-- Offcanvas menú lateral -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasNavbarLabel">SGAR</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav flex-column">

                    <AuthorizeView Roles="Ciudadano">
                        <li class="nav-item"><NavLink class="nav-link" href="/menuC">Menú Ciudadano</NavLink></li>
                    </AuthorizeView>

                    <AuthorizeView Roles="Operador">
                        <li class="nav-item"><NavLink class="nav-link" href="/menuOp">Menú Operador</NavLink></li>
                    </AuthorizeView>

                    <AuthorizeView Roles="Organizacion">
                        <li class="nav-item"><NavLink class="nav-link" href="/menuOrg">Menú Organización</NavLink></li>
                    </AuthorizeView>

                    <AuthorizeView Roles="Asociado">
                        <li class="nav-item"><NavLink class="nav-link" href="/menuAso">Menú Asociado</NavLink></li>
                    </AuthorizeView>

                    <AuthorizeView Roles="Administrador">
                        <li class="nav-item"><NavLink class="nav-link" href="/administrador/menuAdmin">Menú Administrador</NavLink></li>
                    </AuthorizeView>

                    <li class="nav-item"><NavLink class="nav-link" href="/">Inicio</NavLink></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

@code {
    private async Task CerrarSesion()
    {
        var customAuthProvider = (CustomAuthStateProvider)AuthStateProvider;

        await customAuthProvider.MarkUserAsLoggedOut();

        Navigation.NavigateTo("/", true);
    }
}