@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FrontEnd_SGAR.Providers
@using System.Security.Claims
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@attribute [Authorize]

<nav class="navbar navbar-light bg-white shadow-sm">
    <div class="container-fluid">
        <button class="navbar-toggler p-2 me-2 d-block" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Logo SGAR -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="css/sgarLetra.png" alt="SGAR" width="90" height="30" class="me-2" href="/" />
        </a>

        <!-- Dropdown Iniciar Sesión -->
        <div class="ms-auto">
            <AuthorizeView>

                <Authorized>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-none d-md-inline fw-bold">
                                <!--Nombre del autenticado-->
                                @context.User.Identity.Name
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <h6 class="dropdown-header">
                                    <!-- Rol del autenticado -->
                                    Rol: @(context.User.FindFirst(ClaimTypes.Role)?.Value ?? context.User.FindFirst("role")?.Value)
                                </h6>
                            </li>
                            <li><hr class="dropdown-divider"></li>

                            <!-- Botón para ADMINISTRADOR -->
                            <AuthorizeView Roles="Administrador" Context="innerContext">
                                <li>
                                    <button class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuAdmin")'>
                                        <i class="bi bi-shield-lock-fill me-2 text-danger"></i> Menu Admininitrador
                                    </button>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para ASOCIADO -->
                            <AuthorizeView Roles="Asociado" Context="innerContext">
                                <li>
                                    <button class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuAsociado")'>
                                        <i class="bi bi-briefcase-fill me-2 text-primary"></i> Menu Asociado
                                    </button>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para OPERADOR -->
                            <AuthorizeView Roles="Operador" Context="innerContext">
                                <li>
                                    <button class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuOperador")'>
                                        <i type="submit" class="bi bi-truck me-2 text-warning"></i> Menu Operador
                                    </button>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para ORGANIZACIÓN -->
                            <AuthorizeView Roles="Organizacion" Context="innerContext">
                                <li>
                                    <button class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuOrganizacion")'>
                                        <i class="bi bi-building-fill me-2 text-info"></i> Menu Organización
                                    </button>
                                </li>
                            </AuthorizeView>

                            <!-- Botón para CIUDADANO -->
                            <AuthorizeView Roles="Ciudadano" Context="innerContext">
                                <li>
                                    <button class="dropdown-item" @onclick='() => Navigation.NavigateTo("/MenuCiudadano")'>
                                        <i class="bi bi-person-badge me-2 text-success"></i> Menú Ciudadano
                                    </button>
                                </li>
                            </AuthorizeView>

                            <li>
                                <button class="dropdown-item text-danger" @onclick="CerrarSesion">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>

                </Authorized>

                <NotAuthorized>
                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Iniciar Sesión
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/login-ciudadano">Ciudadano</a></li>
                            <li><a class="dropdown-item" href="/login-admin">Administrador</a></li>
                            <li><a class="dropdown-item" href="/login-organizacion">Organización</a></li>
                            <li><a class="dropdown-item" href="/login-asociado">Asociado</a></li>
                            <li><a class="dropdown-item" href="/login-operador">Operador</a></li>
                        </ul>
                    </div>
                </NotAuthorized>

            </AuthorizeView>
        </div>

       <div class="offcanvas offcanvas-start bg-light" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
    
    <div class="offcanvas-header bg-white text-dark shadow-sm pb-3">
        <h5 class="offcanvas-title fw-bold" id="offcanvasNavbarLabel">
            <i class="bi bi-list-nested me-2"></i> SGAR Menú
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button> 
    </div>
    
    <div class="offcanvas-body">
        <ul class="navbar-nav flex-column gap-1">

            <AuthorizeView Roles="Administrador">
                <li class="nav-item">
                    <h6 class="dropdown-header text-danger">ADMINISTRACIÓN</h6>
                </li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-tags-fill me-3"></i> Categorías</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-map-fill me-3"></i> Zonas</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-signpost-2-fill me-3"></i> Rutas</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-trash3-fill me-3"></i> Clasificar Residuos</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-person-badge-fill me-3"></i> Autorizar Administradores</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-danger d-flex align-items-center" href="/tipos-suscripcion-index"><i class="bi bi-journal-text me-3"></i> Planes</NavLink></li>
                <hr class="mt-2 mb-2"/>
            </AuthorizeView>

            <AuthorizeView Roles="Asociado">
                <li class="nav-item">
                    <h6 class="dropdown-header text-info">ASOCIADOS</h6>
                </li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-info d-flex align-items-center" href="/plan-suscripcion-index"><i class="bi bi-credit-card-fill me-3"></i> Comprar Plan</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-info d-flex align-items-center" href="/producto-index"><i class="bi bi-box-seam-fill me-3"></i> Registrar Productos</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-info d-flex align-items-center" href="/empresa-index"><i class="bi bi-building-fill me-3"></i> Registrar Empresas</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-info d-flex align-items-center" href="/categoria-index"><i class="bi bi-tag-fill me-3"></i> Gestionar Categorías</NavLink></li>
                <hr class="mt-2 mb-2"/>
            </AuthorizeView>

            <AuthorizeView Roles="Organizacion">
                <li class="nav-item">
                    <h6 class="dropdown-header text-primary">GESTIÓN ORGANIZACIÓN</h6>
                </li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-primary d-flex align-items-center" href="/horarios"><i class="bi bi-people-fill me-3"></i> Gestión Organización</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-primary d-flex align-items-center" href="/mantenimiento"><i class="bi bi-truck-flatbed me-3"></i> Gestión Vehículos</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-primary d-flex align-items-center" href="/ubicacion"><i class="bi bi-clock-fill me-3"></i> Gestión Horarios</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-primary d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-ui-checks-grid me-3"></i> Gestión Formularios</NavLink></li>
                <hr class="mt-2 mb-2"/>
            </AuthorizeView>

            <AuthorizeView Roles="Operador">
                <li class="nav-item">
                    <h6 class="dropdown-header text-warning">OPERADOR</h6>
                </li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-warning d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-calendar-check-fill me-3"></i> Horarios</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-warning d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-tools me-3"></i> Mantenimiento</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-warning d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-geo-alt-fill me-3"></i> Ubicación</NavLink></li>
                <hr class="mt-2 mb-2"/>
            </AuthorizeView>

            <AuthorizeView Roles="Ciudadano">
                <li class="nav-item">
                    <h6 class="dropdown-header text-success">CIUDADANOS</h6>
                </li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-calendar3 me-3"></i> Horarios y Zonas</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-bell-fill me-3"></i> Notificaciones</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-map-pin-fill me-3"></i> Ubicación</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-joystick me-3"></i> SGAR Game</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-megaphone-fill me-3"></i> Espacio Publicitario</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-list-check me-3"></i> Formularios</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-radar me-3"></i> Radar</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link py-1 text-success d-flex align-items-center" href="/sgarMantenimiento"><i class="bi bi-robot me-3"></i> Asistente EcoSGAR</NavLink></li>
                <hr class="mt-2 mb-2"/>
            </AuthorizeView>
            
            <li class="nav-item">
                <NavLink class="nav-link py-2 text-secondary fw-semibold d-flex align-items-center" href="/menu">
                    <i class="bi bi-house-fill me-3"></i> Inicio General
                </NavLink>
            </li>

        </ul>
    </div>
</div>


    </div>
</nav>

@code {
    private async Task CerrarSesion()
    {
        var customAuthProvider = (CustomAuthStateProvider)AuthStateProvider;

        await customAuthProvider.MarkUserAsLoggedOut();

        Navigation.NavigateTo("/", true);
    }
}